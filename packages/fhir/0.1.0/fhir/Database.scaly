; The database layer's neutral side: the provider, one case per database,
; and what the server does with it at its start.

use fhir.postgresql.DatabaseProvider.PostgreSqlProvider
use fhir.sqlite.DatabaseProvider.SqliteProvider

; The version of the schema this software is written for (upstream's
; Database.SoftwareVersion).

; Which provider the server runs on, for the threads that serve requests:
; stored once at the start, before they exist, and only through
; scaly_atomic_* (an ordinary global would be thread-local).
shared atomic database_kind: u64 0

; Set when the server found no schema at its start and created it: the seed
; data goes in then (upstream's Database, ImportSeedData).
shared atomic database_fresh: u64 0

procedure database_is_fresh() returns bool
    scaly_atomic_load_u64(&database_fresh) <> 0

procedure database_created()
    scaly_atomic_store_u64(&database_fresh, 1)

procedure database_in_use() returns u64
    scaly_atomic_load_u64(&database_kind)

define DatabaseProvider union
(
    PostgreSql: PostgreSqlProvider
    Sqlite: SqliteProvider
)

; Does a provider exist for this DatabaseType?
function supported_database(database_type: Slice[u8]) returns bool
    database_type.equals("PostgreSql") or database_type.equals("Sqlite")

; The provider of a supported DatabaseType, its strings on page.
procedure make_provider(page: ref[Page], database_type: Slice[u8], connection_string: Slice[u8]) returns DatabaseProvider
{
    if database_type.equals("Sqlite")
        return DatabaseProvider.Sqlite(SqliteProvider.parse(page, connection_string))
    DatabaseProvider.PostgreSql(PostgreSqlProvider.parse(page, connection_string))
}

; The work at the server's start: the database answers and has the schema.
; False when it does not.
procedure initialize(db: DatabaseProvider) returns bool mutable sqlite_thread
{
    choose db
        when p: PostgreSql
        {
            scaly_atomic_store_u64(&database_kind, DATABASE_POSTGRESQL)
            return p.initialize(model_version())
        }
        when s: Sqlite
        {
            scaly_atomic_store_u64(&database_kind, DATABASE_SQLITE)
            return s.initialize(model_version())
        }
}

; A script the model carries for the database in use, by what it is for
; (schema, indexes.create, indexes.drop, upgrade.<version>); empty when
; the model has none.
procedure database_script_named(what: Slice[u8]) returns Slice[u8]
{
    var key Array[u8]()
    if database_in_use() = DATABASE_SQLITE
        key.append("sqlite.")
    else
        key.append("postgresql.")
    key.append(what)
    model_value(61, key.as_slice())
}
