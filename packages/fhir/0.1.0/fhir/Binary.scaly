; Binary, the one type whose payload is not kept in its content: upstream
; stores the bytes of `data` in a table of their own, the content with
; "data": null, and puts them back -- encoded anew -- when the resource is
; read. Read without a wish for FHIR, a Binary is answered as the bytes
; themselves. (The white space .NET's Convert.FromBase64String passes over
; is what the standard library's base64_decode passes over.)

use http.Request.Request
use http.Response.Response
use json.Value.JsonValue

; Does the type keep its data apart?
procedure keeps_data_apart(type: Slice[u8]) returns bool
{
    if database_in_use() = DATABASE_SQLITE
        return false
    type.equals("Binary")
}

; Does haystack contain needle?
function contains(haystack: Slice[u8], needle: Slice[u8]) returns bool
{
    var i: size_t 0
    while i + needle.length <= haystack.length
    {
        if haystack.subslice(i, i + needle.length).equals(needle)
            return true
        i := i + 1
    }
    false
}

; Answer the resource in content as its bytes with its own content type --
; when the type keeps data apart, the request does not ask for FHIR
; (_format with json or xml, an Accept field with fhir) and the resource
; has both. False when it is to be answered as a resource.
procedure send_raw(type: Slice[u8], req: ref[Request], mutable res: ref[Response], content: Slice[u8]) returns bool
{
    if keeps_data_apart(type) = false
        return false
    let format req.query_param("_format")
    if contains(format, "json") or contains(format, "xml") or contains(req.header("accept"), "fhir")
        return false
    let parsed JsonValue.parse(content)
    if parsed.ok() = false
        return false
    let content_type parsed.value.get("contentType")
    let data parsed.value.get("data")
    if content_type.is_text() = false or data.is_text() = false
        return false
    var bytes Array[u8]()
    if base64_decode(data.text(), &bytes) = false
        return false
    res.send(content_type.text(), bytes.as_slice())
    true
}
