; PATCH /fire/<type>/{id}: a JSON Patch (RFC 6902) on the stored resource, as
; upstream's JsonPatcher applies it and its handler answers -- the same
; operations, the same refusals in the same words, and like upstream no
; validation of what comes out.
;
; A document here is its text. An operation is carried out by writing the
; document anew with the change at its place: what is not touched is written
; as System.Text.Json writes it, which is how upstream stores the result.

use http.Request.Request
use http.Response.Response
use json.Value.JsonValue
use json.Writer.JsonWriter
use fhir.Resource.StoreResult

define PATCH_ADD: int 1
define PATCH_REMOVE: int 2
define PATCH_REPLACE: int 3

; The message of a refusal: what and of what.
procedure patch_problem(mutable problem: ref[Array[u8]], what: Slice[u8], of: Slice[u8]) returns bool
{
    problem.length := 0
    put_bytes(problem, what)
    put_bytes(problem, of)
    false
}

; The segments of a JSON Pointer into text and cells, ~1 and ~0 taken back.
; False for a pointer that does not begin with a slash.
procedure pointer_segments(pointer: Slice[u8], mutable text: ref[Array[u8]], mutable cells: ref[Array[i64]]) returns bool
{
    if pointer.length = 0
        return false
    let lead pointer[0]
    if lead <> 47
        return false
    var from text.length
    var i: size_t 1
    while i < pointer.length
    {
        let c pointer[i]
        if c = 47
        {
            cells.add(from as i64)
            cells.add((text.length - from) as i64)
            from := text.length
            i := i + 1
            continue
        }
        if c = 126 and i + 1 < pointer.length
        {
            let next pointer[i + 1]
            if next = 49
            {
                text.add(47 as u8)
                i := i + 2
                continue
            }
            if next = 48
            {
                text.add(126 as u8)
                i := i + 2
                continue
            }
        }
        text.add(c)
        i := i + 1
    }
    cells.add(from as i64)
    cells.add((text.length - from) as i64)
    true
}

function segment(text: Slice[u8], cells: Slice[i64], i: size_t) returns Slice[u8]
    text.subslice(cells[i * 2] as size_t, (cells[i * 2] + cells[i * 2 + 1]) as size_t)

; A whole number as int.TryParse takes one: a sign and digits. -1 in `ok`
; when it is none.
function index_of(s: Slice[u8]) returns i64
{
    var at: size_t 0
    var negative false
    if s.length > 0
    {
        let sign s[0]
        if sign = 45 or sign = 43
        {
            negative := sign = 45
            at := 1
        }
    }
    if at >= s.length or s.length - at > 9
        return 1000000000
    var value: i64 0
    while at < s.length
    {
        let d s[at]
        if d < 48 or d > 57
            return 1000000000
        value := value * 10 + ((d as i64) - 48)
        at := at + 1
    }
    if negative
        return 0 - value
    value
}

; Is s a whole number (index_of answers 1000000000 for what is none)?
function is_index(s: Slice[u8]) returns bool
    index_of(s) <> 1000000000

; node written into w with the change at the path's segments from `at` on:
; `insert` (a JSON text) added or put in place, or the place removed. False,
; with `problem`, where upstream throws.
procedure write_changed(mutable w: ref[JsonWriter], node: JsonValue, text: Slice[u8], cells: Slice[i64], at: size_t, action: int, insert: Slice[u8], path: Slice[u8], mutable problem: ref[Array[u8]]) returns bool
{
    let count cells.length / 2
    let name segment(text, cells, at)
    let last at + 1 = count
    if node.is_array()
    {
        let length node.length() as i64
        if last
        {
            var index length
            let append name.equals("-")
            if append = false
            {
                if is_index(name) = false
                    return patch_problem(problem, "Invalid array index: ", name)
                index := index_of(name)
            }
            var shown Array[u8]()
            put_decimal(&shown, index)
            if action = PATCH_ADD
            {
                if append = false and (index < 0 or index > length)
                    return patch_problem(problem, "Array index out of bounds: ", shown.as_slice())
            }
            else if index < 0 or index >= length
                return patch_problem(problem, "Array index out of bounds: ", shown.as_slice())
            w.begin_array()
            var i: i64 0
            while i < length
            {
                if i = index
                {
                    if action = PATCH_ADD
                    {
                        w.raw(insert)
                        w.value_dotnet(node.item(i as size_t))
                    }
                    if action = PATCH_REPLACE
                        w.raw(insert)
                }
                else
                    w.value_dotnet(node.item(i as size_t))
                i := i + 1
            }
            if action = PATCH_ADD and index = length
                w.raw(insert)
            w.end_array()
            return true
        }
        if is_index(name) = false
            return patch_problem(problem, "Invalid array index: ", name)
        let index index_of(name)
        if index < 0 or index >= length
            return patch_problem(problem, "Invalid array index: ", name)
        if node.item(index as size_t).is_null()
        {
            var shown Array[u8]()
            put_decimal(&shown, index)
            return patch_problem(problem, "Null element at index ", shown.as_slice())
        }
        w.begin_array()
        var i: i64 0
        while i < length
        {
            if i = index
            {
                if write_changed(w, node.item(i as size_t), text, cells, at + 1, action, insert, path, problem) = false
                    return false
            }
            else
                w.value_dotnet(node.item(i as size_t))
            i := i + 1
        }
        w.end_array()
        return true
    }
    if node.is_object()
    {
        if last
        {
            let there node.has(name)
            if there = false and action <> PATCH_ADD
                return patch_problem(problem, "Path not found: ", path)
            w.begin_object()
            var i: size_t 0
            while i < node.length()
            {
                if node.key_at(i).equals(name)
                {
                    if action <> PATCH_REMOVE
                    {
                        w.key_dotnet(name)
                        w.raw(insert)
                    }
                }
                else
                {
                    w.key_dotnet(node.key_at(i))
                    w.value_dotnet(node.value_at(i))
                }
                i := i + 1
            }
            if there = false
            {
                w.key_dotnet(name)
                w.raw(insert)
            }
            w.end_object()
            return true
        }
        if node.get(name).is_null()
            return patch_problem(problem, "Path not found: ", name)
        w.begin_object()
        var i: size_t 0
        while i < node.length()
        {
            w.key_dotnet(node.key_at(i))
            if node.key_at(i).equals(name)
            {
                if write_changed(w, node.value_at(i), text, cells, at + 1, action, insert, path, problem) = false
                    return false
            }
            else
                w.value_dotnet(node.value_at(i))
            i := i + 1
        }
        w.end_object()
        return true
    }
    ; a value that is neither: upstream goes no further into it, and at the
    ; end of the path does nothing to it
    if last
    {
        w.value_dotnet(node)
        return true
    }
    patch_problem(problem, "Cannot traverse scalar value", "")
}

; One of add, remove, replace on the document in `document`, which is
; replaced by what comes out.
procedure change_document(mutable document: ref[Array[u8]], action: int, path: Slice[u8], insert: Slice[u8], mutable problem: ref[Array[u8]]) returns bool
{
    if path.length = 0
        return patch_problem(problem, "Empty path", "")
    var text Array[u8]()
    var cells Array[i64]()
    if pointer_segments(path, &text, &cells) = false
        return patch_problem(problem, "Invalid JSON Pointer: ", path)
    let parsed JsonValue.parse(document.as_slice())
    if parsed.ok() = false
        return patch_problem(problem, "Invalid JSON", "")
    var w JsonWriter()
    if write_changed(&w, parsed.value, text.as_slice(), cells.as_slice(), 0, action, insert, path, problem) = false
        return false
    document.length := 0
    put_bytes(document, w.bytes())
    true
}

; What a pointer names in the document, as a JSON text into `out`; `null`
; where there is nothing. False, with `problem`, where upstream throws.
procedure pointed(document: Slice[u8], path: Slice[u8], mutable out: ref[Array[u8]], mutable problem: ref[Array[u8]]) returns bool
{
    let parsed JsonValue.parse(document)
    if parsed.ok() = false
        return patch_problem(problem, "Invalid JSON", "")
    var current parsed.value
    if path.length > 0
    {
        var text Array[u8]()
        var cells Array[i64]()
        if pointer_segments(path, &text, &cells) = false
            return patch_problem(problem, "Invalid JSON Pointer: ", path)
        var i: size_t 0
        while i * 2 < cells.length
        {
            let name segment(text.as_slice(), cells.as_slice(), i)
            if current.is_array()
            {
                if is_index(name) = false
                    return patch_problem(problem, "Invalid array index: ", name)
                let index index_of(name)
                if index < 0 or index >= (current.length() as i64)
                    return patch_problem(problem, "Invalid array index: ", name)
                current := current.item(index as size_t)
            }
            else if current.is_object()
                current := current.get(name)
            else
                return patch_problem(problem, "Cannot traverse path: ", name)
            i := i + 1
        }
    }
    var w JsonWriter()
    w.value_dotnet(current)
    put_bytes(out, w.bytes())
    true
}

; The value of an operation as a JSON text into out; false when it has none.
procedure operation_value(op: JsonValue, mutable out: ref[Array[u8]], mutable problem: ref[Array[u8]]) returns bool
{
    if op.has("value") = false
        return patch_problem(problem, "Missing 'value' in patch operation", "")
    var w JsonWriter()
    w.value_dotnet(op.get("value"))
    put_bytes(out, w.bytes())
    true
}

; Every operation of the patch on the document, in its order.
procedure apply_patch(mutable document: ref[Array[u8]], patch: JsonValue, mutable problem: ref[Array[u8]]) returns bool
{
    var k: size_t 0
    while k < patch.length()
    {
        let op patch.item(k)
        k := k + 1
        if op.get("op").is_text() = false
            return patch_problem(problem, "Missing 'op' in patch operation", "")
        if op.get("path").is_text() = false
            return patch_problem(problem, "Missing 'path' in patch operation", "")
        let operation op.get("op").text()
        let path op.get("path").text()
        var value Array[u8]()
        if operation.equals("add")
        {
            if operation_value(op, &value, problem) = false or change_document(document, PATCH_ADD, path, value.as_slice(), problem) = false
                return false
            continue
        }
        if operation.equals("remove")
        {
            if change_document(document, PATCH_REMOVE, path, "", problem) = false
                return false
            continue
        }
        if operation.equals("replace")
        {
            if operation_value(op, &value, problem) = false or change_document(document, PATCH_REPLACE, path, value.as_slice(), problem) = false
                return false
            continue
        }
        if operation.equals("move") or operation.equals("copy")
        {
            if op.get("from").is_text() = false
                return patch_problem(problem, "Missing 'from' in patch operation", "")
            let from op.get("from").text()
            if pointed(document.as_slice(), from, &value, problem) = false
                return false
            if operation.equals("move") and change_document(document, PATCH_REMOVE, from, "", problem) = false
                return false
            if change_document(document, PATCH_ADD, path, value.as_slice(), problem) = false
                return false
            continue
        }
        if operation.equals("test")
        {
            var now Array[u8]()
            if operation_value(op, &value, problem) = false or pointed(document.as_slice(), path, &now, problem) = false
                return false
            if now.as_slice().equals(value.as_slice()) = false
                return patch_problem(problem, "Test failed at ", path)
            continue
        }
        return patch_problem(problem, "Unknown patch operation: ", operation)
    }
    true
}

; The version an If-Match names as upstream's Patch reads it: the digits of
; the first W/"<digits>" in the field; -1 when there is none.
function patch_if_match(field: Slice[u8]) returns i64
{
    var i: size_t 0
    while i + 3 < field.length
    {
        let c0 field[i]
        let c1 field[i + 1]
        let c2 field[i + 2]
        if c0 = 87 and c1 = 47 and c2 = 34
        {
            var at i + 3
            var value: i64 0
            var digits 0
            while at < field.length
            {
                let d field[at]
                if d < 48 or d > 57
                    break
                value := value * 10 + ((d as i64) - 48)
                digits := digits + 1
                at := at + 1
            }
            if digits > 0 and at < field.length
            {
                let close field[at]
                if close = 34
                    return value
            }
        }
        i := i + 1
    }
    -1
}

procedure resource_patch(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    let id req.param("id")
    let parsed JsonValue.parse(req.body)
    if parsed.ok() = false or parsed.value.is_array() = false
        return send_error(res, "invalid", "Invalid JSON Patch", 400)
    let wanted patch_if_match(trim(req.header("if-match")))

    ; upstream reads, changes and writes in one transaction; here the write
    ; names the version that was read, and what came between is read again
    var attempt 0
    while attempt < 5
    {
        attempt := attempt + 1
        var document Array[u8]()
        let read resource_select(0, type, id, 0, &document)
        if read.status = FAILED
            return send_unavailable(res)
        if read.status <> STORED
            return not_found(res, type, id, "")
        if wanted >= 0 and wanted <> read.version_id
        {
            var message Array[u8]()
            put_bytes(&message, "Version conflict: current version is ")
            put_decimal(&message, read.version_id)
            return send_error(res, "conflict", message.as_slice(), 409)
        }
        var problem Array[u8]()
        if apply_patch(&document, parsed.value, &problem) = false
            return send_error(res, "invalid", problem.as_slice(), 400)
        let changed JsonValue.parse(document.as_slice())
        if changed.ok() = false or changed.value.is_object() = false
            return send_error(res, "exception", "An unexpected internal error occurred.", 500)
        var content Array[u8]()
        let stored resource_update(0, type, changed.value, id, read.version_id, &content)
        if stored.status = CONFLICT
            continue
        if stored.status = UNREADABLE
            return send_error(res, "invalid", "The input is not a valid Base-64 string as it contains a non-base 64 character, more than two padding characters, or an illegal character among the padding characters.", 400)
        if stored.status = NOT_FOUND
            return not_found(res, type, id, "")
        if stored.status <> STORED
            return send_unavailable(res)
        version_fields(res, "", type, id, stored.version_id, stored.seconds)
        return send_stored(req, res, content.as_slice())
    }
    send_error(res, "conflict", "Version conflict", 409)
}
