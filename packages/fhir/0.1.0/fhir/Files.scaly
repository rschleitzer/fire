; The files of the web root, which upstream serves before any route: the
; scripts and style sheets the HTML form of an answer asks for, and the
; pages of the documentation. The root is ASPNETCORE_WEBROOT, else
; `wwwroot` where the server runs; without that directory at the start
; nothing is served. A GET or HEAD for a file that is there is answered
; with it, everything else goes on to the routes.
;
; Not upstream's: the validators (ETag, Last-Modified), ranges, a path
; with an escape in it, the redirect of a directory to its trailing slash.

use http.Request.Request
use http.Response.Response

; The media type ASP.NET gives a file of this name; empty for a name it
; would not serve.
function file_media_type(name: Slice[u8]) returns Slice[u8]
{
    var dot name.length
    while dot > 0 and name[dot - 1] <> 46 and name[dot - 1] <> 47
        dot := dot - 1
    if dot = 0 or name[dot - 1] <> 46
        return ""
    var lowered Array[u8]()
    put_lower_case(&lowered, name.slice_from(dot))
    let ext lowered.as_slice()
    if ext.equals("html") or ext.equals("htm")
        return "text/html"
    if ext.equals("css")
        return "text/css"
    if ext.equals("js")
        return "text/javascript"
    if ext.equals("png")
        return "image/png"
    if ext.equals("gif")
        return "image/gif"
    if ext.equals("jpg") or ext.equals("jpeg")
        return "image/jpeg"
    if ext.equals("svg")
        return "image/svg+xml"
    if ext.equals("ico")
        return "image/x-icon"
    if ext.equals("json")
        return "application/json"
    if ext.equals("txt")
        return "text/plain"
    if ext.equals("xml")
        return "text/xml"
    ""
}

; The directory the files are served from.
procedure web_root() returns String
{
    let configured setting("ASPNETCORE_WEBROOT")
    if configured.length > 0
        return String(configured.data as pointer[const_char], configured.length)
    String("wwwroot")
}

; Send the file rel of the web root when there is one.
procedure send_file(mutable res: ref[Response], rel: Slice[u8]) returns bool mutable static_cache
{
    let media file_media_type(rel)
    if media.length = 0 or safe_relative(rel) = false
        return false
    var root web_root()
    var path Array[u8]()
    put_bytes(&path, root.as_slice())
    path.add(47 as u8)
    put_bytes(&path, rel)
    let entry static_entry(path.as_slice())
    if entry.present = false
        return false
    res.send(media, entry.content.as_slice())
    true
}

; Before the routes: a file of the web root, a directory's default file.
procedure web_file(req: ref[Request], mutable res: ref[Response]) mutable static_cache
{
    if req.is_method("GET") = false and req.is_method("HEAD") = false
        return
    let path req.path
    if path.length = 0 or path[0] <> 47
        return
    ; (what the server's own routes answer is no file)
    var routes Array[u8]()
    put_bytes(&routes, model_route())
    routes.add(47 as u8)
    if path.starts_with(routes.as_slice())
        return
    let rel path.slice_from(1)
    if rel.length > 0 and rel[rel.length - 1] <> 47
    {
        send_file(res, rel)
        return
    }
    var name Array[u8]()
    put_bytes(&name, rel)
    let base name.length
    put_bytes(&name, "default.htm")
    if send_file(res, name.as_slice())
        return
    name.length := base
    put_bytes(&name, "default.html")
    if send_file(res, name.as_slice())
        return
    name.length := base
    put_bytes(&name, "index.htm")
    if send_file(res, name.as_slice())
        return
    name.length := base
    put_bytes(&name, "index.html")
    send_file(res, name.as_slice())
}
