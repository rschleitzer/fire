; The resources in PostgreSQL, on upstream's tables and in upstream's
; steps: every write is one transaction, the version that is replaced or
; deleted goes to the history first. One set of statements per type, made
; from the type's name and its columns.

use fhir.Db.DbConn
use json.Value.JsonValue
use json.Writer.JsonWriter
use fhir.Instant.Instant
use fhir.Resource.StoreResult
use fhir.sql.SearchQueryBuilder.SearchQuery

; The statement `what` of a type: its name on the connection.
procedure statement_name(mutable name: ref[Array[u8]], type: Slice[u8], what: Slice[u8])
{
    name.add(type)
    name.add(95 as u8)
    name.add(what)
}

; , "name" for every column of the type.
procedure put_column_names(mutable sql: ref[Array[u8]], type: Slice[u8])
{
    let columns inline_columns(type)
    var i: size_t 0
    while entry(columns, 44, i).length > 0
    {
        put_bytes(sql, ", \"")
        sql.add(column_name(entry(columns, 44, i)))
        put_bytes(sql, "\"")
        i := i + 1
    }
}

; "Type", quoted as a table's name is.
procedure put_table(mutable sql: ref[Array[u8]], type: Slice[u8])
{
    put_bytes(sql, "\"")
    sql.add(type)
    put_bytes(sql, "\"")
}

; The parameters every statement that writes a version has after the id:
; version, last_updated, content, and the type's columns out of root.
procedure version_params(mutable c: ref[DbConn], type: Slice[u8], root: JsonValue, version_id: i64, now: Instant, content: Slice[u8])
{
    var written Array[u8]()
    put_timestamp(&written, now)
    var timestamp Array[u8]()
    put_database_time(&timestamp, written.as_slice())
    c.param_int(version_id)
    c.param_text(timestamp.as_slice())
    c.param_bytes(content)
    let columns inline_columns(type)
    var i: size_t 0
    while entry(columns, 44, i).length > 0
    {
        column_param(c, entry(columns, 44, i), root)
        i := i + 1
    }
}

; The value a resource has for one of its type's own search columns
; (`name:kind`), as the next parameter.
procedure column_param(mutable c: ref[DbConn], column: Slice[u8], root: JsonValue)
{
    let value root.get(column_member(column))
    if column[column.length - 1] = 98
    {
        if value.is_bool() = false
            c.param_null()
        else
        {
            ; (SQLite has no boolean: upstream's provider writes 1 and 0)
            if c.kind = DATABASE_SQLITE
            {
                if value.as_bool()
                    c.param_int(1)
                else
                    c.param_int(0)
            }
            else
            {
                if value.as_bool()
                    c.param_text("t")
                else
                    c.param_text("f")
            }
        }
    }
    else
    {
        let kind column[column.length - 1]
        ; a number as it stands in the resource: the database reads it
        if (kind = 105 or kind = 108 or kind = 109) and value.is_number()
            return c.param_text(value.number_text())
        if value.is_text() and kind = 100
        {
            var written Array[u8]()
            put_instant_text(&written, value.text())
            var instant Array[u8]()
            put_database_time(&instant, written.as_slice())
            return c.param_text(instant.as_slice())
        }
        if value.is_text()
            c.param_text(value.text())
        else
            c.param_null()
    }
}

; What a type that keeps its data apart stores of root: the bytes its data
; encodes go to `data`, and the answer is root with "data": null in its
; place. Root itself where there is nothing to take out. False when the
; data is no base64.
procedure take_data(type: Slice[u8], root: JsonValue, mutable data: ref[Array[u8]], mutable apart: ref[bool]) returns bool
{
    apart := false
    if keeps_data_apart(type) = false or root.get("data").is_text() = false
        return true
    if base64_decode(root.get("data").text(), data) = false
        return false
    apart := true
    true
}

; Store the data of version version_id of `id`.
procedure insert_data(mutable c: ref[DbConn], type: Slice[u8], id: Slice[u8], version_id: i64, data: Slice[u8]) returns bool
{
    var name Array[u8]()
    statement_name(&name, type, "data_insert")
    var sql Array[u8]()
    put_bytes(&sql, "INSERT INTO ")
    put_table(&sql, type)
    put_bytes(&sql, ".resource_data (resource_id, version_id, data) VALUES ($1, $2, $3)")
    if c.prepare(name.as_slice(), sql.as_slice()) = false
        return false
    c.start(name.as_slice())
    c.param_text(id)
    c.param_int(version_id)
    c.param_bytes(data)
    c.run()
}

; Put the data of version version_id of `id` back into content, encoded
; anew, when the table has it.
procedure restore_data(mutable c: ref[DbConn], type: Slice[u8], id: Slice[u8], version_id: i64, mutable content: ref[Array[u8]]) returns bool
{
    var name Array[u8]()
    statement_name(&name, type, "data_select")
    var sql Array[u8]()
    put_bytes(&sql, "SELECT data FROM ")
    put_table(&sql, type)
    put_bytes(&sql, ".resource_data WHERE resource_id = $1 AND version_id = $2")
    if c.prepare(name.as_slice(), sql.as_slice()) = false
        return false
    c.start(name.as_slice())
    c.param_text(id)
    c.param_int(version_id)
    c.binary_column(0)
    if c.run() = false
        return false
    if c.next_row() = false
        return true
    var encoded Array[u8]()
    base64_encode(c.column(0), &encoded)
    let parsed JsonValue.parse(content.as_slice())
    if parsed.ok() = false
        return false
    var w JsonWriter()
    w.value_dotnet(parsed.value.with_member("data", JsonValue.of_text(encoded.as_slice())))
    content.length := 0
    content.add(w.bytes())
    true
}

; Write the version: what is stored into `stored` -- without its data when
; the type keeps that apart --, and what is answered into content.
procedure write_version(type: Slice[u8], root: JsonValue, apart: bool, id: Slice[u8], version_id: i64, now: Instant, mutable stored: ref[Array[u8]], mutable content: ref[Array[u8]])
{
    if apart
    {
        write_resource(root.with_member("data", JsonValue.Null), id, version_id, now, stored)
        write_resource(root, id, version_id, now, content)
        return
    }
    write_resource(root, id, version_id, now, stored)
    content.add(stored.as_slice())
}

; The columns of a search table of that kind, after id and resource_id.
function search_columns(kind: u8) returns Slice[u8]
{
    match kind as int
        case 116: return "system, value"
        case 100: return "value_low, value_high"
        case 114: return "target_type, target_id, target_version"
        case 113: return "value, system, code, unit"
    "value"
}

; Fill the search tables of `id` from root, as upstream's
; InsertSearchIndexesAsync does: a row for every value its extractors find.
procedure insert_searches(mutable c: ref[DbConn], type: Slice[u8], id: Slice[u8], root: JsonValue) returns bool
{
    let tables model_searches(type)
    var at: size_t 0
    while at < tables.length
    {
        let line line_from(tables, at)
        at := at + line.length + 1
        if line[0] = 105
            continue
        if insert_search(c, type, id, root, line) = false
            return false
    }
    true
}

; The rows of ONE search table (its line of the model) for `id`.
procedure insert_search(mutable c: ref[DbConn], type: Slice[u8], id: Slice[u8], root: JsonValue, line: Slice[u8]) returns bool
{
    var text Array[u8]()
    var cells Array[i64]()
    search_rows(line, root, &text, &cells)
    let width row_width(line[0])
    if cells.length = 0
        return true
    var name Array[u8]()
    statement_name(&name, type, entry(line, 32, 1))
    var sql Array[u8]()
    put_bytes(&sql, "INSERT INTO ")
    put_table(&sql, type)
    put_bytes(&sql, ".")
    sql.add(entry(line, 32, 1))
    put_bytes(&sql, " (id, resource_id, ")
    put_bytes(&sql, search_columns(line[0]))
    put_bytes(&sql, ") VALUES ($1, $2")
    var p: size_t 0
    while p < width
    {
        put_bytes(&sql, ", $")
        put_decimal(&sql, (p + 3) as i64)
        p := p + 1
    }
    put_bytes(&sql, ")")
    if c.prepare(name.as_slice(), sql.as_slice()) = false
        return false
    var row: size_t 0
    while row * width * 2 < cells.length
    {
        c.start(name.as_slice())
        c.param_int(row as i64)
        c.param_text(id)
        var k: size_t 0
        while k < width
        {
            let offset cells[(row * width + k) * 2]
            let length cells[(row * width + k) * 2 + 1]
            if length < 0
                c.param_null()
            else
                c.param_text(text.as_slice().subslice(offset as size_t, (offset + length) as size_t))
            k := k + 1
        }
        if c.run() = false
            return false
        row := row + 1
    }
    true
}

; Empty the search tables of `id`.
procedure delete_searches(mutable c: ref[DbConn], type: Slice[u8], id: Slice[u8]) returns bool
{
    let tables model_searches(type)
    var at: size_t 0
    while at < tables.length
    {
        let line line_from(tables, at)
        at := at + line.length + 1
        if line[0] = 105
            continue
        var name Array[u8]()
        statement_name(&name, type, entry(line, 32, 1))
        put_bytes(&name, "_clear")
        var sql Array[u8]()
        put_bytes(&sql, "DELETE FROM ")
        put_table(&sql, type)
        put_bytes(&sql, ".")
        sql.add(entry(line, 32, 1))
        put_bytes(&sql, " WHERE resource_id = $1")
        if c.prepare(name.as_slice(), sql.as_slice()) = false
            return false
        c.start(name.as_slice())
        c.param_text(id)
        if c.run() = false
            return false
    }
    true
}

; Begin an operation's own transaction; within a scope there is one.
; (SQLite takes the write lock at once, as Microsoft.Data.Sqlite's
; BeginTransaction does: two writers then wait for each other instead of
; failing when both go on to write.)
procedure begin(mutable c: ref[DbConn], scope: u64) returns bool
{
    if scope <> 0
        return true
    if c.kind = DATABASE_SQLITE
        return c.execute("BEGIN IMMEDIATE")
    c.execute("BEGIN")
}

; End an operation: its own transaction is committed when ok, else rolled
; back, and its connection given back; within a scope nothing ends here,
; and what failed fails the scope.
procedure end_transaction(mutable c: ref[DbConn], scope: u64, ok: bool) returns bool mutable pg_pool, sqlite_thread
{
    if scope <> 0
        return ok
    var done false
    if ok
        done := c.execute("COMMIT")
    else
        c.execute("ROLLBACK")
    release_connection(c)
    done
}

; Give the connection of an operation that only read back.
procedure give_back(mutable c: ref[DbConn], scope: u64) mutable pg_pool, sqlite_thread
{
    if scope = 0
        release_connection(c)
}

; A transaction over several operations: its scope, 0 when the database
; does not answer.
procedure sql_begin() returns u64 mutable pg_pool, sqlite_thread
{
    var held connection(0)
    if held.missing()
        return 0
    var c &held
    if begin(c, 0) = false
    {
        release_connection(c)
        return 0
    }
    scope_of(c)
}

; End the transaction `scope`: commit it, or roll it back.
procedure sql_end(scope: u64, commit: bool) returns bool mutable pg_pool, sqlite_thread
{
    var held connection(scope)
    if held.missing()
        return false
    var c &held
    var done false
    if commit
        done := c.execute("COMMIT")
    else
        done := c.execute("ROLLBACK")
    release_connection(c)
    done
}

; The current version of `id`, the row locked: 0 when there is none, -1
; when the database did not answer.
procedure lock_current(mutable c: ref[DbConn], type: Slice[u8], id: Slice[u8]) returns i64
{
    var name Array[u8]()
    statement_name(&name, type, "lock")
    var sql Array[u8]()
    put_bytes(&sql, "SELECT version_id FROM ")
    put_table(&sql, type)
    put_bytes(&sql, " WHERE id = $1 FOR UPDATE")
    if c.prepare(name.as_slice(), sql.as_slice()) = false
        return -1
    c.start(name.as_slice())
    c.param_text(id)
    if c.run() = false
        return -1
    if c.next_row() = false
        return 0
    c.column_int(0)
}

; Copy the current version of `id` to the history.
procedure keep_history(mutable c: ref[DbConn], type: Slice[u8], id: Slice[u8], operation: Slice[u8]) returns bool
{
    var name Array[u8]()
    statement_name(&name, type, "keep")
    var sql Array[u8]()
    put_bytes(&sql, "INSERT INTO ")
    put_table(&sql, type)
    put_bytes(&sql, ".resource_history (id, version_id, last_updated, content")
    put_column_names(&sql, type)
    put_bytes(&sql, ", history_operation) SELECT id, version_id, last_updated, content")
    put_column_names(&sql, type)
    put_bytes(&sql, ", $2 FROM ")
    put_table(&sql, type)
    put_bytes(&sql, " WHERE id = $1")
    if c.prepare(name.as_slice(), sql.as_slice()) = false
        return false
    c.start(name.as_slice())
    c.param_text(id)
    c.param_text(operation)
    c.run()
}

; Create the resource `id` from root; its stored bytes are appended to
; content. An id the client chose (after_delete) continues the versions its
; history holds.
procedure sql_create(scope: u64, type: Slice[u8], root: JsonValue, id: Slice[u8], after_delete: bool, mutable content: ref[Array[u8]]) returns StoreResult mutable pg_pool, sqlite_thread
{
    var data Array[u8]()
    var apart false
    if take_data(type, root, &data, &apart) = false
        return StoreResult(UNREADABLE, 0, 0)
    var stored Array[u8]()
    var held connection(scope)
    if held.missing()
        return StoreResult(FAILED, 0, 0)
    var c &held
    var version_id: i64 1
    var ok begin(c, scope)
    if ok and after_delete and type_versioned(type)
    {
        var name Array[u8]()
        statement_name(&name, type, "versions")
        var sql Array[u8]()
        put_bytes(&sql, "SELECT COALESCE(MAX(version_id), 0) FROM ")
        put_table(&sql, type)
        put_bytes(&sql, ".resource_history WHERE id = $1")
        ok := c.prepare(name.as_slice(), sql.as_slice())
        if ok
        {
            c.start(name.as_slice())
            c.param_text(id)
            ok := c.run() and c.next_row()
            if ok and c.column_int(0) > 0
                version_id := c.column_int(0) + 1
        }
    }
    let now instant_now()
    if ok
    {
        write_version(type, root, apart, id, version_id, now, &stored, content)
        var name Array[u8]()
        statement_name(&name, type, "insert")
        var sql Array[u8]()
        put_bytes(&sql, "INSERT INTO ")
        put_table(&sql, type)
        put_bytes(&sql, " (id, version_id, last_updated, content")
        put_column_names(&sql, type)
        put_bytes(&sql, ") VALUES ($1, $2, $3, $4")
        let columns inline_columns(type)
        var i: size_t 0
        while entry(columns, 44, i).length > 0
        {
            put_bytes(&sql, ", $")
            put_decimal(&sql, (i + 5) as i64)
            i := i + 1
        }
        put_bytes(&sql, ")")
        ok := c.prepare(name.as_slice(), sql.as_slice())
        if ok
        {
            c.start(name.as_slice())
            c.param_text(id)
            version_params(c, type, root, version_id, now, stored.as_slice())
            ok := c.run()
        }
        if ok and apart
            ok := insert_data(c, type, id, version_id, data.as_slice())
        if ok
            ok := insert_searches(c, type, id, root)
    }
    if end_transaction(c, scope, ok) = false
        return StoreResult(FAILED, 0, 0)
    StoreResult(STORED, version_id, now.seconds)
}

; Replace the resource `id` by root; if_match is the version the client
; expects, 0 for none.
procedure sql_update(scope: u64, type: Slice[u8], root: JsonValue, id: Slice[u8], if_match: i64, mutable content: ref[Array[u8]]) returns StoreResult mutable pg_pool, sqlite_thread
{
    var data Array[u8]()
    var apart false
    if take_data(type, root, &data, &apart) = false
        return StoreResult(UNREADABLE, 0, 0)
    var stored Array[u8]()
    var held connection(scope)
    if held.missing()
        return StoreResult(FAILED, 0, 0)
    var c &held
    if begin(c, scope) = false
    {
        end_transaction(c, scope, false)
        return StoreResult(FAILED, 0, 0)
    }
    let current lock_current(c, type, id)
    if current <= 0 or (if_match > 0 and if_match <> current)
    {
        end_transaction(c, scope, false)
        if current < 0
            return StoreResult(FAILED, 0, 0)
        if current = 0
            return StoreResult(NOT_FOUND, 0, 0)
        return StoreResult(CONFLICT, current, 0)
    }
    var ok true
    if type_versioned(type)
        ok := keep_history(c, type, id, "UPDATE")
    let now instant_now()
    if ok
    {
        write_version(type, root, apart, id, current + 1, now, &stored, content)
        var name Array[u8]()
        statement_name(&name, type, "update")
        var sql Array[u8]()
        put_bytes(&sql, "UPDATE ")
        put_table(&sql, type)
        put_bytes(&sql, " SET version_id = $2, last_updated = $3, content = $4")
        let columns inline_columns(type)
        var i: size_t 0
        while entry(columns, 44, i).length > 0
        {
            put_bytes(&sql, ", \"")
            sql.add(column_name(entry(columns, 44, i)))
            put_bytes(&sql, "\" = $")
            put_decimal(&sql, (i + 5) as i64)
            i := i + 1
        }
        put_bytes(&sql, " WHERE id = $1")
        ok := c.prepare(name.as_slice(), sql.as_slice())
        if ok
        {
            c.start(name.as_slice())
            c.param_text(id)
            version_params(c, type, root, current + 1, now, stored.as_slice())
            ok := c.run()
        }
        if ok and apart
            ok := insert_data(c, type, id, current + 1, data.as_slice())
        if ok
            ok := delete_searches(c, type, id) and insert_searches(c, type, id, root)
    }
    if end_transaction(c, scope, ok) = false
        return StoreResult(FAILED, 0, 0)
    StoreResult(STORED, current + 1, now.seconds)
}

; Delete the resource `id`: STORED, NOT_FOUND or FAILED.
procedure sql_delete(scope: u64, type: Slice[u8], id: Slice[u8]) returns int mutable pg_pool, sqlite_thread
{
    var held connection(scope)
    if held.missing()
        return FAILED
    var c &held
    if begin(c, scope) = false
    {
        end_transaction(c, scope, false)
        return FAILED
    }
    let current lock_current(c, type, id)
    if current <= 0
    {
        end_transaction(c, scope, false)
        if current < 0
            return FAILED
        return NOT_FOUND
    }
    var ok true
    if type_versioned(type)
        ok := keep_history(c, type, id, "DELETE")
    else
    {
        ; no history to keep the bytes for: they go with the resource
        if keeps_data_apart(type)
        {
            var bytes Array[u8]()
            put_bytes(&bytes, "DELETE FROM ")
            put_table(&bytes, type)
            put_bytes(&bytes, ".resource_data WHERE resource_id = $1")
            ok := run_for(c, type, "delete-data", bytes.as_slice(), id, 0)
        }
    }
    if ok
    {
        var name Array[u8]()
        statement_name(&name, type, "delete")
        var sql Array[u8]()
        put_bytes(&sql, "DELETE FROM ")
        put_table(&sql, type)
        put_bytes(&sql, " WHERE id = $1")
        ok := c.prepare(name.as_slice(), sql.as_slice())
        if ok
        {
            c.start(name.as_slice())
            c.param_text(id)
            ok := c.run()
        }
    }
    if end_transaction(c, scope, ok) = false
        return FAILED
    STORED
}

; Does the server answer a query?
procedure sql_ready() returns bool mutable pg_pool, sqlite_thread
{
    var held connection(0)
    if held.missing()
        return false
    var c &held
    let answered c.execute("SELECT 1")
    give_back(c, 0)
    answered
}

; One statement with the id and, when version_id is not 0, the version as
; its parameters.
procedure run_for(mutable c: ref[DbConn], type: Slice[u8], what: Slice[u8], sql: Slice[u8], id: Slice[u8], version_id: i64) returns bool
{
    var name Array[u8]()
    statement_name(&name, type, what)
    if c.prepare(name.as_slice(), sql) = false
        return false
    c.start(name.as_slice())
    c.param_text(id)
    if version_id > 0
        c.param_int(version_id)
    c.run()
}

; The Provenances written for `id` of `type` no earlier than its current
; version, as lines of ids -- those upstream's rollback removes with the
; version they record: they name the resource by exactly <type>/<id>.
procedure provenance_since(mutable c: ref[DbConn], type: Slice[u8], id: Slice[u8], mutable ids: ref[Array[u8]]) returns bool
{
    var sql Array[u8]()
    put_bytes(&sql, "SELECT p.id, p.content FROM \"Provenance\" p WHERE p.last_updated >= (SELECT last_updated FROM ")
    put_table(&sql, type)
    put_bytes(&sql, " WHERE id = $1) AND p.id IN (SELECT resource_id FROM \"Provenance\".search_target WHERE target_type = $2 AND target_id = $1) ORDER BY p.id")
    if c.prepare_unnamed(sql.as_slice()) = false
        return false
    c.start("")
    c.param_text(id)
    c.param_text(type)
    c.binary_column(1)
    if c.run() = false
        return false
    var exact Array[u8]()
    put_bytes(&exact, type)
    put_bytes(&exact, "/")
    put_bytes(&exact, id)
    while c.next_row()
    {
        let parsed JsonValue.parse(c.column(1))
        if parsed.ok() = false
            continue
        let targets parsed.value.get("target")
        var t: size_t 0
        while t < targets.length()
        {
            let reference targets.item(t).get("reference")
            if reference.is_text() and reference.text().equals(exact.as_slice())
            {
                put_bytes(ids, c.column(0))
                ids.add(10 as u8)
                break
            }
            t := t + 1
        }
    }
    true
}

; Undo the current version `version_id` of `id`, as upstream's
; RollbackAsync: the current row goes, and the last row of the history
; comes back in its place -- unless that row is a deletion (the resource
; stays deleted) or there is none (the resource is gone). The Provenance
; written for the undone version goes with it, without a trace. What the
; resource is afterwards -- or was last -- is appended to content;
; NOT_FOUND when the current version is not the one named.
procedure sql_rollback(scope: u64, type: Slice[u8], id: Slice[u8], version_id: i64, mutable content: ref[Array[u8]]) returns StoreResult mutable pg_pool, sqlite_thread
{
    var held connection(scope)
    if held.missing()
        return StoreResult(FAILED, 0, 0)
    var c &held
    if begin(c, scope) = false
    {
        end_transaction(c, scope, false)
        return StoreResult(FAILED, 0, 0)
    }
    let current lock_current(c, type, id)
    if current <= 0 or current <> version_id
    {
        end_transaction(c, scope, false)
        if current < 0
            return StoreResult(FAILED, 0, 0)
        return StoreResult(NOT_FOUND, 0, 0)
    }
    var undone Array[u8]()
    var result select_row(c, type, "select", false, id, 0, &undone)
    var ok result.status = STORED
    var provenances Array[u8]()
    if ok and known_type("Provenance")
        ok := provenance_since(c, type, id, &provenances)

    var sql Array[u8]()
    if ok
    {
        put_bytes(&sql, "DELETE FROM ")
        put_table(&sql, type)
        put_bytes(&sql, " WHERE id = $1")
        ok := run_for(c, type, "delete", sql.as_slice(), id, 0)
    }
    if ok and keeps_data_apart(type)
    {
        sql.length := 0
        put_bytes(&sql, "DELETE FROM ")
        put_table(&sql, type)
        put_bytes(&sql, ".resource_data WHERE resource_id = $1 AND version_id = $2")
        ok := run_for(c, type, "undo-data", sql.as_slice(), id, version_id)
    }

    ; the last row of the history: its version and what wrote it
    var previous: i64 0
    var was_delete false
    if ok
    {
        sql.length := 0
        put_bytes(&sql, "SELECT version_id, history_operation FROM ")
        put_table(&sql, type)
        put_bytes(&sql, ".resource_history WHERE id = $1 ORDER BY version_id DESC LIMIT 1")
        ok := run_for(c, type, "last", sql.as_slice(), id, 0)
        if ok and c.next_row()
        {
            previous := c.column_int(0)
            was_delete := c.column(1).equals("DELETE")
        }
    }
    if ok and previous = 0
        content.add(undone.as_slice())
    if ok and previous > 0 and was_delete
    {
        result := select_row(c, type, "history", true, id, previous, content)
        ok := result.status = STORED
    }
    if ok and previous > 0 and was_delete = false
    {
        sql.length := 0
        put_bytes(&sql, "INSERT INTO ")
        put_table(&sql, type)
        put_bytes(&sql, " (id, version_id, last_updated, content")
        put_column_names(&sql, type)
        put_bytes(&sql, ") SELECT id, version_id, last_updated, content")
        put_column_names(&sql, type)
        put_bytes(&sql, " FROM ")
        put_table(&sql, type)
        put_bytes(&sql, ".resource_history WHERE id = $1 AND version_id = $2")
        ok := run_for(c, type, "back", sql.as_slice(), id, previous)
        if ok
        {
            sql.length := 0
            put_bytes(&sql, "DELETE FROM ")
            put_table(&sql, type)
            put_bytes(&sql, ".resource_history WHERE id = $1 AND version_id = $2")
            ok := run_for(c, type, "forget", sql.as_slice(), id, previous)
        }
        if ok
        {
            result := select_row(c, type, "select", false, id, 0, content)
            ok := result.status = STORED
        }
        if ok
        {
            let parsed JsonValue.parse(content.as_slice())
            ok := parsed.ok() and insert_searches(c, type, id, parsed.value)
        }
    }
    if ok and previous > 0 and keeps_data_apart(type)
        ok := restore_data(c, type, id, result.version_id, content)

    ; the Provenance of the undone version, hard
    var at: size_t 0
    while ok and at < provenances.length
    {
        let provenance line_from(provenances.as_slice(), at)
        at := at + provenance.length + 1
        ok := run_for(c, "Provenance", "hard", "DELETE FROM \"Provenance\" WHERE id = $1", provenance, 0)
        if ok
            ok := run_for(c, "Provenance", "hard-history", "DELETE FROM \"Provenance\".resource_history WHERE id = $1", provenance, 0)
    }
    if end_transaction(c, scope, ok) = false
        return StoreResult(FAILED, 0, 0)
    StoreResult(STORED, result.version_id, result.seconds)
}

; The statements that make a search table and its indexes, as upstream's
; CreateSearchAsync has them for a table of that kind.
procedure put_search_table(mutable sql: ref[Array[u8]], type: Slice[u8], line: Slice[u8])
{
    let table entry(line, 32, 1)
    let kind line[0]
    put_bytes(sql, "CREATE TABLE IF NOT EXISTS ")
    put_table(sql, type)
    put_bytes(sql, ".")
    put_bytes(sql, table)
    put_bytes(sql, " (id INT NOT NULL, resource_id VARCHAR(64) NOT NULL REFERENCES ")
    put_table(sql, type)
    put_bytes(sql, "(id) ON DELETE CASCADE, ")
    var indexed: Slice[u8] "value"
    match kind as int
        case 116: put_bytes(sql, "system TEXT, value TEXT, display TEXT")
        case 100
        {
            put_bytes(sql, "value_low TIMESTAMPTZ, value_high TIMESTAMPTZ")
            indexed := "value_low"
        }
        case 114
        {
            put_bytes(sql, "target_type TEXT, target_id TEXT, target_version TEXT")
            indexed := "reference"
        }
        case 110: put_bytes(sql, "value DECIMAL")
        case 113: put_bytes(sql, "value DECIMAL, system TEXT, code TEXT, unit TEXT")
        else: put_bytes(sql, "value TEXT")
    put_bytes(sql, ", PRIMARY KEY (id, resource_id))")
    put_search_index(sql, type, table, indexed)
    if kind = 100
        put_search_index(sql, type, table, "value_high")
    if kind = 116 and (table.equals("search_identifier") or table.equals("search_language"))
        put_search_index(sql, type, table, "system")
}

procedure put_search_index(mutable sql: ref[Array[u8]], type: Slice[u8], table: Slice[u8], what: Slice[u8])
{
    put_bytes(sql, "; CREATE INDEX IF NOT EXISTS ix_")
    put_bytes(sql, type)
    put_bytes(sql, "_")
    put_bytes(sql, table)
    put_bytes(sql, "_")
    put_bytes(sql, what)
    put_bytes(sql, " ON ")
    put_table(sql, type)
    put_bytes(sql, ".")
    put_bytes(sql, table)
    if what.equals("reference")
        put_bytes(sql, " (target_id, target_type)")
    else
    {
        put_bytes(sql, " (")
        put_bytes(sql, what)
        put_bytes(sql, ")")
    }
}

; A search parameter's table made and filled from every stored resource --
; for one that is a column of the resource, the column filled --, as
; upstream's CreateSearchAsync. REFUSED for a parameter the type has none
; of; FAILED also where the table holds rows already (upstream fails on the
; key, too).
procedure sql_create_search(scope: u64, type: Slice[u8], parameter: Slice[u8]) returns int mutable pg_pool, sqlite_thread
{
    let line search_line(type, parameter)
    if line.length = 0
        return REFUSED
    var held connection(scope)
    if held.missing()
        return FAILED
    var c &held
    var ok true
    if line[0] <> 105
    {
        var ddl Array[u8]()
        put_search_table(&ddl, type, line)
        ok := c.execute(ddl.as_slice())
    }
    ; every resource first, then the writes: one statement at a time
    var read Array[u8]()
    var cells Array[i64]()
    if ok
    {
        var sql Array[u8]()
        put_bytes(&sql, "SELECT id, content FROM ")
        put_table(&sql, type)
        ok := c.prepare_unnamed(sql.as_slice())
        if ok
        {
            c.start("")
            c.binary_column(1)
            ok := c.run()
            while ok and c.next_row()
            {
                cell(&read, &cells, c.column(0))
                cell(&read, &cells, c.column(1))
            }
        }
    }
    var r: size_t 0
    while ok and r * 4 < cells.length
    {
        let id read.as_slice().subslice(cells[r * 4] as size_t, (cells[r * 4] + cells[r * 4 + 1]) as size_t)
        let parsed JsonValue.parse(read.as_slice().subslice(cells[r * 4 + 2] as size_t, (cells[r * 4 + 2] + cells[r * 4 + 3]) as size_t))
        r := r + 1
        if parsed.ok() = false
            continue
        if line[0] <> 105
        {
            ok := insert_search(c, type, id, parsed.value, line)
            continue
        }
        ; the column: its entry among the type's own (name:kind)
        let columns inline_columns(type)
        var k: size_t 0
        while entry(columns, 44, k).length > 0
        {
            let column entry(columns, 44, k)
            k := k + 1
            if column_name(column).equals(entry(line, 32, 3)) = false
                continue
            var sql Array[u8]()
            put_bytes(&sql, "UPDATE ")
            put_table(&sql, type)
            put_bytes(&sql, " SET \"")
            put_bytes(&sql, entry(line, 32, 3))
            put_bytes(&sql, "\" = $1 WHERE id = $2")
            var name Array[u8]()
            statement_name(&name, type, entry(line, 32, 1))
            put_bytes(&name, "_fill")
            ok := c.prepare(name.as_slice(), sql.as_slice())
            if ok
            {
                c.start(name.as_slice())
                column_param(c, column, parsed.value)
                c.param_text(id)
                ok := c.run()
            }
        }
    }
    give_back(c, scope)
    if ok = false
        return FAILED
    STORED
}

; A search parameter's table dropped, as upstream's DropSearchAsync.
; REFUSED for a parameter the type has no table of.
procedure sql_drop_search(type: Slice[u8], parameter: Slice[u8]) returns int mutable pg_pool, sqlite_thread
{
    let line search_line(type, parameter)
    if line.length = 0 or line[0] = 105
        return REFUSED
    var sql Array[u8]()
    put_bytes(&sql, "DROP TABLE IF EXISTS ")
    put_table(&sql, type)
    put_bytes(&sql, ".")
    put_bytes(&sql, entry(line, 32, 1))
    if sql_script(0, sql.as_slice()) = false
        return FAILED
    STORED
}

; The selection upstream's PurgeAsync works on: the ids that have a deletion
; in their history and no current row -- with `bounded`, those whose last
; history row was written before $1.
procedure put_purge_selection(mutable sql: ref[Array[u8]], type: Slice[u8], bounded: bool)
{
    put_bytes(sql, "SELECT h.id FROM ")
    put_table(sql, type)
    put_bytes(sql, ".resource_history h LEFT JOIN ")
    put_table(sql, type)
    put_bytes(sql, " r ON h.id = r.id WHERE r.id IS NULL AND h.history_operation = 'DELETE' GROUP BY h.id")
    if bounded
        put_bytes(sql, " HAVING MAX(h.history_timestamp) < $1::timestamptz")
}

; One statement of the purge, with the bound as its parameter when there
; is one.
procedure run_purge(mutable c: ref[DbConn], sql: Slice[u8], before: Slice[u8]) returns bool
{
    if c.prepare_unnamed(sql) = false
        return false
    c.start("")
    if before.length > 0
        c.param_text(before)
    c.run()
}

; The purge of a type, as upstream's PurgeAsync: every deleted resource's
; history goes (and a Binary's bytes), counted by resources. `before` is an
; instant with its zone, or empty; `shown` gets it as .NET's round-trip
; format writes it. REFUSED when the database does not take it for an
; instant.
procedure sql_purge(type: Slice[u8], before: Slice[u8], mutable shown: ref[Array[u8]], mutable count: ref[Array[i64]]) returns int mutable pg_pool, sqlite_thread
{
    var held connection(0)
    if held.missing()
        return FAILED
    var c &held
    let bounded before.length > 0
    if bounded
    {
        var understood c.prepare_unnamed("SELECT to_char($1::timestamptz AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US')")
        if understood
        {
            c.start("")
            c.param_text(before)
            understood := c.run() and c.next_row()
        }
        if understood = false
        {
            give_back(c, 0)
            return REFUSED
        }
        put_bytes(shown, c.column(0))
        put_bytes(shown, "0Z")
    }
    ; a type without history has nothing to purge
    if type_versioned(type) = false
    {
        give_back(c, 0)
        count.add(0)
        return STORED
    }
    var sql Array[u8]()
    put_bytes(&sql, "SELECT COUNT(*) FROM (")
    put_purge_selection(&sql, type, bounded)
    put_bytes(&sql, ") t")
    var ok run_purge(c, sql.as_slice(), before) and c.next_row()
    var found: i64 0
    if ok
        found := c.column_int(0)
    if ok and found > 0 and keeps_data_apart(type)
    {
        sql.length := 0
        put_bytes(&sql, "DELETE FROM ")
        put_table(&sql, type)
        put_bytes(&sql, ".resource_data WHERE resource_id IN (")
        put_purge_selection(&sql, type, bounded)
        put_bytes(&sql, ")")
        ok := run_purge(c, sql.as_slice(), before)
    }
    if ok and found > 0
    {
        sql.length := 0
        put_bytes(&sql, "DELETE FROM ")
        put_table(&sql, type)
        put_bytes(&sql, ".resource_history WHERE id IN (")
        put_purge_selection(&sql, type, bounded)
        put_bytes(&sql, ")")
        ok := run_purge(c, sql.as_slice(), before)
    }
    give_back(c, 0)
    if ok = false
        return FAILED
    count.add(found)
    STORED
}

; The ids of a type that are in its history and not there, a line each.
procedure sql_deleted_ids(type: Slice[u8], mutable ids: ref[Array[u8]]) returns int mutable pg_pool, sqlite_thread
{
    var held connection(0)
    if held.missing()
        return FAILED
    var c &held
    var sql Array[u8]()
    put_bytes(&sql, "SELECT DISTINCT h.id FROM ")
    put_table(&sql, type)
    put_bytes(&sql, ".resource_history h LEFT JOIN ")
    put_table(&sql, type)
    put_bytes(&sql, " r ON h.id = r.id WHERE r.id IS NULL")
    var ok c.prepare_unnamed(sql.as_slice())
    if ok
    {
        c.start("")
        ok := c.run()
        while ok and c.next_row()
        {
            put_bytes(ids, c.column(0))
            ids.add(10 as u8)
        }
    }
    give_back(c, 0)
    if ok = false
        return FAILED
    STORED
}

; Everything of a type gone -- its search rows, a Binary's bytes, its
; history, its resources --, as upstream's ReseedTruncateSql.
procedure sql_truncate(type: Slice[u8]) returns bool mutable pg_pool, sqlite_thread
{
    var sql Array[u8]()
    let tables model_searches(type)
    var at: size_t 0
    while at < tables.length
    {
        let line line_from(tables, at)
        at := at + line.length + 1
        if line[0] = 105
            continue
        put_bytes(&sql, "DELETE FROM ")
        put_table(&sql, type)
        put_bytes(&sql, ".")
        put_bytes(&sql, entry(line, 32, 1))
        put_bytes(&sql, "; ")
    }
    if keeps_data_apart(type)
    {
        put_bytes(&sql, "DELETE FROM ")
        put_table(&sql, type)
        put_bytes(&sql, ".resource_data; ")
    }
    if type_versioned(type)
    {
        put_bytes(&sql, "DELETE FROM ")
        put_table(&sql, type)
        put_bytes(&sql, ".resource_history; ")
    }
    put_bytes(&sql, "DELETE FROM ")
    put_table(&sql, type)
    sql_script(0, sql.as_slice())
}

; A script sent as it is -- on the connection of the transaction `scope`,
; or (0) on one of its own.
procedure sql_script(scope: u64, sql: Slice[u8]) returns bool mutable pg_pool, sqlite_thread
{
    var held connection(scope)
    if held.missing()
        return false
    var c &held
    let done c.execute(sql)
    give_back(c, scope)
    done
}

; The version the database is at, into `version`; false when it does not
; say.
procedure sql_version(mutable version: ref[Array[u8]]) returns bool mutable pg_pool, sqlite_thread
{
    var held connection(0)
    if held.missing()
        return false
    var c &held
    ; (as a statement, not a script: a script has no rows on SQLite)
    var found c.prepare_unnamed("SELECT value FROM \"fire_meta\".dbinfo WHERE name = 'version'")
    if found
    {
        c.start("")
        found := c.run() and c.next_row()
    }
    if found
        put_bytes(version, c.column(0))
    give_back(c, 0)
    found
}

; Was the resource `id` deleted at some time?
procedure sql_is_deleted(scope: u64, type: Slice[u8], id: Slice[u8]) returns bool mutable pg_pool, sqlite_thread
{
    var held connection(scope)
    if held.missing()
        return false
    var c &held
    var deleted false
    var name Array[u8]()
    statement_name(&name, type, "deleted")
    var sql Array[u8]()
    put_bytes(&sql, "SELECT COUNT(*) FROM ")
    put_table(&sql, type)
    put_bytes(&sql, ".resource_history WHERE id = $1 AND history_operation = 'DELETE'")
    if c.prepare(name.as_slice(), sql.as_slice())
    {
        c.start(name.as_slice())
        c.param_text(id)
        deleted := c.run() and c.next_row() and c.column_int(0) > 0
    }
    give_back(c, scope)
    deleted
}

; One row of a type's select statement `what` (from its table, or with
; history its history; with version_id not 0 that version) into content.
procedure select_row(mutable c: ref[DbConn], type: Slice[u8], what: Slice[u8], history: bool, id: Slice[u8], version_id: i64, mutable content: ref[Array[u8]]) returns StoreResult
{
    var name Array[u8]()
    statement_name(&name, type, what)
    var sql Array[u8]()
    if c.kind = DATABASE_SQLITE
        put_bytes(&sql, "SELECT version_id, CAST(strftime('%s', last_updated) AS INTEGER), content FROM ")
    else
        put_bytes(&sql, "SELECT version_id, FLOOR(EXTRACT(EPOCH FROM last_updated))::BIGINT, content FROM ")
    put_table(&sql, type)
    if history
        put_bytes(&sql, ".resource_history")
    put_bytes(&sql, " WHERE id = $1")
    if version_id > 0
        put_bytes(&sql, " AND version_id = $2")
    if c.prepare(name.as_slice(), sql.as_slice()) = false
        return StoreResult(FAILED, 0, 0)
    c.start(name.as_slice())
    c.param_text(id)
    if version_id > 0
        c.param_int(version_id)
    c.binary_column(2)
    if c.run() = false
        return StoreResult(FAILED, 0, 0)
    if c.next_row() = false
        return StoreResult(NOT_FOUND, 0, 0)
    content.add(c.column(2))
    StoreResult(STORED, c.column_int(0), c.column_int(1))
}

; Read the resource `id` -- its current version, or version_id (not 0) from
; the current row or the history; the content is appended to `content`.
procedure sql_select(scope: u64, type: Slice[u8], id: Slice[u8], version_id: i64, mutable content: ref[Array[u8]]) returns StoreResult mutable pg_pool, sqlite_thread
{
    var held connection(scope)
    if held.missing()
        return StoreResult(FAILED, 0, 0)
    var c &held
    var result StoreResult(FAILED, 0, 0)
    if version_id = 0
        result := select_row(c, type, "select", false, id, 0, content)
    else
    {
        result := select_row(c, type, "version", false, id, version_id, content)
        if result.status = NOT_FOUND and type_versioned(type)
            result := select_row(c, type, "history", true, id, version_id, content)
    }
    if result.status = STORED and keeps_data_apart(type) and restore_data(c, type, id, result.version_id, content) = false
        result := StoreResult(FAILED, 0, 0)
    give_back(c, scope)
    result
}

; Put the data back into every content of a list that was read with its
; versions: read holds, for each row, `width` cells of which the first is
; the id and the last the content, and versions the version of each row.
; The rows are written anew into found and rows.
procedure restore_all(mutable c: ref[DbConn], type: Slice[u8], read: Slice[u8], read_cells: Slice[i64], versions: Slice[i64], width: size_t, mutable found: ref[Array[u8]], mutable rows: ref[Array[i64]]) returns bool
{
    var r: size_t 0
    while r < versions.length
    {
        let first r * width * 2
        var k: size_t 0
        while k + 1 < width
        {
            cell(found, rows, read.subslice(read_cells[first + k * 2] as size_t, (read_cells[first + k * 2] + read_cells[first + k * 2 + 1]) as size_t))
            k := k + 1
        }
        let last first + (width - 1) * 2
        var content Array[u8]()
        put_bytes(&content, read.subslice(read_cells[last] as size_t, (read_cells[last] + read_cells[last + 1]) as size_t))
        if content.length > 0 and restore_data(c, type, read.subslice(read_cells[first] as size_t, (read_cells[first] + read_cells[first + 1]) as size_t), versions[r], &content) = false
            return false
        cell(found, rows, content.as_slice())
        r := r + 1
    }
    true
}

; Bind the parameters of q to the statement started on c.
procedure bind_parameters(mutable c: ref[DbConn], q: ref[SearchQuery])
{
    var i: size_t 0
    while i * 2 < q.cells.length
    {
        let offset q.cells[i * 2]
        let length q.cells[i * 2 + 1]
        if length < 0
            c.param_null()
        else
            c.param_text(q.text.as_slice().subslice(offset as size_t, (offset + length) as size_t))
        i := i + 1
    }
}

; Search the resources of `type` by the pairs of a request (text, cells:
; fire/Query.scaly): at most `count` of them from `offset` on, their ids
; and contents appended to found, with a cell each in rows (id, content).
; The answer's status is STORED and its version_id the number of ALL that
; match; REFUSED, with `problem`, for what upstream refuses, BROKEN for
; what it fails on, FAILED when the database does not answer.
procedure sql_search(scope: u64, type: Slice[u8], text: Slice[u8], cells: Slice[i64], count: i64, offset: i64, mutable found: ref[Array[u8]], mutable rows: ref[Array[i64]], mutable problem: ref[Array[u8]]) returns StoreResult mutable pg_pool, sqlite_thread
{
    var q SearchQuery()
    var i: size_t 0
    while i < pair_count(cells)
    {
        if add_parameter(&q, type, pair_key(text, cells, i), pair_value(text, cells, i), problem) = false
        {
            if problem.length > 0
                return StoreResult(REFUSED, 0, 0)
            return StoreResult(BROKEN, 0, 0)
        }
        i := i + 1
    }
    var order Array[u8]()
    if put_order(&q, type, &order, problem) = false
        return StoreResult(REFUSED, 0, 0)
    var matching Array[u8]()
    put_bytes(&matching, " FROM ")
    put_table(&matching, type)
    put_bytes(&matching, " r")
    matching.add(q.joins.as_slice())
    if q.conditions > 0
    {
        put_bytes(&matching, " WHERE ")
        matching.add(q.wheres.as_slice())
    }

    var held connection(scope)
    if held.missing()
        return StoreResult(FAILED, 0, 0)
    var c &held
    var counting Array[u8]()
    put_bytes(&counting, "SELECT COUNT(DISTINCT r.id)")
    counting.add(matching.as_slice())
    ; a search's text is made for this request: the statement is not kept
    var total: i64 0
    var ok c.prepare_unnamed(counting.as_slice())
    if ok
    {
        c.start("")
        bind_parameters(c, &q)
        ok := c.run() and c.next_row()
        if ok
            total := c.column_int(0)
    }
    if ok and count > 0
    {
        var page Array[u8]()
        put_bytes(&page, "SELECT r2.id, r2.content, r2.version_id FROM ")
        put_table(&page, type)
        put_bytes(&page, " r2 WHERE r2.id IN (SELECT DISTINCT r.id")
        page.add(matching.as_slice())
        put_bytes(&page, ") ORDER BY ")
        page.add(order.as_slice())
        put_bytes(&page, " LIMIT $")
        put_decimal(&page, (q.cells.length / 2 + 1) as i64)
        put_bytes(&page, " OFFSET $")
        put_decimal(&page, (q.cells.length / 2 + 2) as i64)
        ok := c.prepare_unnamed(page.as_slice())
        if ok
        {
            c.start("")
            bind_parameters(c, &q)
            c.param_int(count)
            c.param_int(offset)
            c.binary_column(1)
            ok := c.run()
            if keeps_data_apart(type)
            {
                ; the data is in a table of its own: read the page first
                var read Array[u8]()
                var read_cells Array[i64]()
                var versions Array[i64]()
                while ok and c.next_row()
                {
                    cell(&read, &read_cells, c.column(0))
                    cell(&read, &read_cells, c.column(1))
                    versions.add(c.column_int(2))
                }
                if ok
                    ok := restore_all(c, type, read.as_slice(), read_cells.as_slice(), versions.as_slice(), 2, found, rows)
            }
            else
            {
                while ok and c.next_row()
                {
                    cell(found, rows, c.column(0))
                    cell(found, rows, c.column(1))
                }
            }
        }
    }
    give_back(c, scope)
    if ok = false
        return StoreResult(FAILED, 0, 0)
    StoreResult(STORED, total, 0)
}

; The versions of the resource `id` -- or, with an empty id, of every
; resource of the type --, newest first, as upstream's history lists them:
; the current row, every row of the history, and for every deletion a
; TOMBSTONE beside its row. At most `count` from `offset` on, each as four
; cells in rows (id, the time it is from, what it is, content); the answer's
; version_id is how many there are in all.
procedure sql_history(scope: u64, type: Slice[u8], id: Slice[u8], count: i64, offset: i64, mutable found: ref[Array[u8]], mutable rows: ref[Array[i64]], mutable keys: ref[Array[i64]]) returns StoreResult mutable pg_pool, sqlite_thread
{
    let one id.length > 0
    var of_id: Slice[u8] ""
    var and_id: Slice[u8] ""
    if one
    {
        of_id := " WHERE id = $1"
        and_id := " AND id = $1"
    }
    var counting Array[u8]()
    put_bytes(&counting, "SELECT (SELECT COUNT(*) FROM ")
    put_table(&counting, type)
    put_bytes(&counting, of_id)
    put_bytes(&counting, ") + (SELECT COUNT(*) FROM ")
    put_table(&counting, type)
    put_bytes(&counting, ".resource_history")
    put_bytes(&counting, of_id)
    put_bytes(&counting, ") + (SELECT COUNT(*) FROM ")
    put_table(&counting, type)
    put_bytes(&counting, ".resource_history WHERE history_operation = 'DELETE'")
    put_bytes(&counting, and_id)
    put_bytes(&counting, ")")
    var listing Array[u8]()
    ; the time as upstream's handler writes it (milliseconds, cut off), and
    ; in microseconds as the key the system's history orders by
    if database_in_use() = DATABASE_SQLITE
        put_bytes(&listing, "SELECT h.id, substr(h.last_updated, 1, 10) || 'T' || substr(h.last_updated, 12, 8) || '.' || substr(substr(h.last_updated, 21) || '000', 1, 3) || '+00:00', h.history_operation, h.content, h.version_id, CAST(strftime('%s', h.last_updated) AS INTEGER) * 1000000 + CAST(substr(substr(h.last_updated, 21) || '000000', 1, 6) AS INTEGER)")
    else
        put_bytes(&listing, "SELECT h.id, to_char(h.last_updated AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.MS') || '+00:00', h.history_operation, h.content, h.version_id, (EXTRACT(EPOCH FROM h.last_updated) * 1000000)::bigint")
    ; (the members of the union without parentheses: SQLite takes none)
    put_bytes(&listing, " FROM (SELECT id, version_id, last_updated, content, 'CURRENT' AS history_operation FROM ")
    put_table(&listing, type)
    put_bytes(&listing, of_id)
    put_bytes(&listing, " UNION ALL SELECT id, version_id, last_updated, content, history_operation FROM ")
    put_table(&listing, type)
    put_bytes(&listing, ".resource_history")
    put_bytes(&listing, of_id)
    put_bytes(&listing, " UNION ALL SELECT id, version_id, last_updated, content, 'TOMBSTONE' AS history_operation FROM ")
    put_table(&listing, type)
    put_bytes(&listing, ".resource_history WHERE history_operation = 'DELETE'")
    put_bytes(&listing, and_id)
    if one
        put_bytes(&listing, ") h ORDER BY h.version_id DESC, h.history_operation DESC LIMIT $2 OFFSET $3")
    else
        put_bytes(&listing, ") h ORDER BY h.last_updated DESC, h.history_operation DESC LIMIT $1 OFFSET $2")

    var held connection(scope)
    if held.missing()
        return StoreResult(FAILED, 0, 0)
    var c &held
    var total: i64 0
    var ok c.prepare_unnamed(counting.as_slice())
    if ok
    {
        c.start("")
        if one
            c.param_text(id)
        ok := c.run() and c.next_row()
        if ok
            total := c.column_int(0)
    }
    if ok
    {
        ok := c.prepare_unnamed(listing.as_slice())
        if ok
        {
            c.start("")
            if one
                c.param_text(id)
            c.param_int(count)
            c.param_int(offset)
            c.binary_column(3)
            ok := c.run()
            if keeps_data_apart(type)
            {
                var read Array[u8]()
                var read_cells Array[i64]()
                var versions Array[i64]()
                while ok and c.next_row()
                {
                    cell(&read, &read_cells, c.column(0))
                    cell(&read, &read_cells, c.column(1))
                    cell(&read, &read_cells, c.column(2))
                    cell(&read, &read_cells, c.column(3))
                    versions.add(c.column_int(4))
                    keys.add(c.column_int(5))
                }
                if ok
                    ok := restore_all(c, type, read.as_slice(), read_cells.as_slice(), versions.as_slice(), 4, found, rows)
            }
            else
            {
                while ok and c.next_row()
                {
                    cell(found, rows, c.column(0))
                    cell(found, rows, c.column(1))
                    cell(found, rows, c.column(2))
                    cell(found, rows, c.column(3))
                    keys.add(c.column_int(5))
                }
            }
        }
    }
    give_back(c, scope)
    if ok = false
        return StoreResult(FAILED, 0, 0)
    StoreResult(STORED, total, 0)
}
