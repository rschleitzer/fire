; The server itself: the model installed, the database reached, the routes
; set, and then it listens until it is ended. `model` is the text the
; generated program wrote (fhir/Tables.scaly) and must outlive the call.
; 0 when it ended in order; 2 an unsupported database, 3 a database that
; cannot be reached or prepared, 4 a port that cannot be listened on.

use http.Router.Router

procedure serve_model(model: Slice[u8]) returns int mutable pg_pool, sqlite_thread
{
    let page Page.allocate_page()
    model_install(page, model)
    let database_type setting_or("DatabaseType", "PostgreSql")
    let connection_string setting_or("ConnectionString", "Host=localhost;Database=Fire;Username=postgres")
    let port port_of(setting("Kestrel__Endpoints__MyHttpEndpoint__Url"), 5080)

    if supported_database(database_type) = false
    {
        Console.println("Unsupported database type: `String(database_type.data as pointer[const_char], database_type.length)`")
        return 2
    }
    let db make_provider(page, database_type, connection_string)
    if initialize(db) = false
        return 3
    if upgrade_database() = false
        return 3
    if database_is_fresh()
    {
        var seeded Array[i64]()
        seed_load(0, "", &seeded)
    }

    var app Router.create(page)
    app.get(pattern(page, "metadata", ""), &metadata)
    app.get(pattern(page, "SearchParameter", ""), &search_parameters)
    app.get(pattern(page, "_history", ""), &system_history)
    app.get("/purgeschema/{type}", &purge)
    app.post("/purgeschema/{type}", &purge)
    app.get("/admin/undelete/{type}", &undelete_all)
    app.get("/admin/createsearch/{type}/{parameter}", &create_search)
    app.get("/admin/dropsearch/{type}/{parameter}", &drop_search)
    app.get("/admin/seed", &seed)
    app.get("/admin/{secret}/reseed/{type}", &reseed)
    app.get("/admin/indexes/create", &indexes_create)
    app.get("/admin/indexes/drop", &indexes_drop)
    app.get("/healthz", &healthz)
    app.get("/readyz", &readyz)
    add_resource_routes(app, page)
    app.post(model_route(), &bundle_post)

    var l TcpListener.listen(port)
    if l.is_open() = false
    {
        Console.println("Cannot listen on port `port`")
        return 4
    }
    Console.println("Now listening on: http://localhost:`port`")
    let server start(app, l)
    server.wait()
    l.close()
    0
}
