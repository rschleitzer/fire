; fhir -- the runtime of a FHIR R5 server that is a drop-in replacement of
; the C# server upstream's generator writes: the same URLs, the same
; settings, the same database. It knows no resource type. A server is a
; small program a generator writes from a model (codegen/ in the repository
; this package lives in): the model as one text of records, and a main that
; hands it to `serve_model`.
;
; The settings come from the environment under the names upstream's
; configuration has (fhir/Config.scaly). The database layer is cut as
; upstream cuts it, a provider per database behind fhir/Database.scaly --
; but its operations are written once (fhir/sql) and speak the dialect of
; the connection they are given (fhir/Db.scaly).

package scaly 0.1.0
package http 0.1.0
package json 0.1.1
package pg 0.2.0
package sqlite 0.1.0
package tds 0.1.0

define fhir
{
    module Config
    module Json
    module Instant
    module Uuid
    module FhirResult
    module Resource
    module Tables
    module Validator
    module Binary
    module Search
    module Query
    module Db
    module postgresql
    module sqlite
    module sqlserver
    module Database
    module sql
    module Repository
    module Chains
    module Composite
    module Subset
    module Metadata
    module Handlers
    module SystemHistory
    module Patch
    module Seed
    module Admin
    module Bundle
    module Upgrade
    module Server
}
