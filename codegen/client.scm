; client.scm -- the search parameters of the model's active resources as a
; Scaly package beside the hand-written fhirclient: a function for each,
; named by resource and parameter, that answers the parameter in its type
; (what upstream's fhirclient.scm writes as a class per resource).
;
;   q.where(patient_family().exact("Brown"))

; A name of the model as a Scaly name: capitals and hyphens become an
; underscore and a small letter, an underscore at the front is left out.
(define (scaly-snake s)
    (let loop ((rest (string->list s)) (out '()) (first #t))
        (if (null? rest)
            (list->string (reverse out))
            (let ((c (car rest)))
                (cond
                    ((or (char=? c #\-) (char=? c #\_))
                        (loop (cdr rest) (if first out (cons #\_ out)) first))
                    ((not (char=? c (char-downcase c)))
                        (loop (cdr rest)
                              (if first (cons (char-downcase c) out) (cons (char-downcase c) (cons #\_ out)))
                              #f))
                    (else (loop (cdr rest) (cons c out) #f)))))))

(define (scaly-client-name) ($ (downcase-string (fhir-name)) "client"))

(define (scaly-param-function search-type)
    (case search-type
        (("date") "date_param")
        (("token") "token_param")
        (("string") "string_param")
        (("reference") "reference_param")
        (("quantity") "quantity_param")
        (("uri") "uri_param")
        (("composite") "composite_param")
        (else #f)))

(define (scaly-client-descriptors resource)
    (let ((rn (name-of resource)))
        ($ "
; " rn "
"       (for (children (select-children "searches" resource))
            (lambda (search)
                (let* ((type (% "type" search))
                       (sname (% "name" search))
                       (maker (scaly-param-function type))
                       (cls (search-param-class type)))
                    (if maker
                        ($ "function " (scaly-snake rn) "_" (scaly-snake sname) "() returns " cls "
    " maker "(\"" sname "\"" (case type (("reference") ($ ", \"" rn "\"")) (else "")) ")
")
                        "")))))))

(define (scaly-client-package)
    (let ((name (scaly-client-name)))
        (make directory path: "packages"
            (make directory path: name
                (make directory path: "0.1.0"
                    (sosofo-append
                        (file ($ name ".scaly") ($
"; GENERATED by codegen/scaly.dsl from model/fhir.xml. Do not edit.
;
; The search parameters of " (fhir-name) "'s resources for the package
; fhirclient: " name "/Parameters.scaly has a function for each.

package scaly 0.1.0
package json 0.1.1
package fhirclient 0.1.0

define " name "
{
    module Parameters
}
"))
                        (make directory path: name
                            (file "Parameters.scaly" ($
"; GENERATED by codegen/scaly.dsl from model/fhir.xml. Do not edit.

use fhirclient.Search.StringParam
use fhirclient.Search.TokenParam
use fhirclient.Search.DateParam
use fhirclient.Search.QuantityParam
use fhirclient.Search.UriParam
use fhirclient.Search.CompositeParam
use fhirclient.Search.ReferenceParam
"                           (for (active-resources-with-searches) scaly-client-descriptors))))))))))
