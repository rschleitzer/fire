; model.scm -- the model as the Scaly server reads it: Model.scaly, one text
; of records (the file's head lists their kinds).
; What upstream writes as one C# class and one Validate method per type is
; here one entry per type; fire/Validator.scaly reads the entries.
;
; A type's entry is its variable's name (upstream's messages name it) and one
; line per member, the fields separated by blanks:
;   s json field path type ref kind class clr notnull     a single member
;   c json field path type ref kind class clr notnull     a collection
;   g n                                                   a choice of the n members that follow
;   a json field path type ref kind class clr             one member of a choice
; json is the member's name in JSON, field and path what upstream's messages
; call it, type and ref what its Validate method goes by (ref: the type of
; an element, the code set of a code, else -), kind, class and clr what its
; model class declares (t a string, b a boolean, i an int, l a long, d a
; decimal, o an object of the type class, - for any; clr is that class as
; the .NET runtime names it, which is how a refusal to read a value names
; it).

(define (scaly-literal s)
    (string-replace (string-replace (string-replace s "\\" "\\\\") "\"" "\\\"") "`" "\\`"))

(define (scaly-resource? el) (string=? "resource" (gi el)))

(define (scaly-type-key el)
    (if (scaly-resource? el) (name-of el) (fhir-validator-name el)))

(define (scaly-explicit el)
    (if (scaly-resource? el) (name-of el) (fhir-model-explicit-name el)))

(define (scaly-var el)
    (escape-csharp-keyword (first-letter-downcase (scaly-explicit el))))

(define (scaly-target ref-attr)
    (if ref-attr
        (let ((target (element-with-id ref-attr)))
            (if (node-list-empty? target) #f target))
        #f))

; What the model class declares for a member.
(define (scaly-declared node)
    (case (% "type" node)
        (("boolean") "b - -")
        (("integer" "positiveInt" "unsignedInt") "i - -")
        (("integer64") "l - -")
        (("decimal") "d - -")
        (("element")
            (let ((target (scaly-target (% "ref" node))))
                (if target ($ "o " (scaly-type-key target) " " (scaly-clr target)) "o - -")))
        (else "t - -")))

; A model class as the .NET runtime names it: Fire.Model.Patient+Contact.
(define (scaly-clr el)
    ($ (fhir-name) ".Model."
        (if (scaly-resource? el)
            (name-of el)
            (string-replace (fhir-model-type-name el) "." "+"))))

; What the Validate method goes by.
(define (scaly-validated vtype ref-attr)
    (let ((target (scaly-target ref-attr)))
        ($ (or vtype "string") " "
            (case vtype
                (("element") (if target (scaly-type-key target) "-"))
                (("code") (if target ref-attr "-"))
                (else "-")))))

(define (scaly-member property el)
    (if (is-variant? property)
        (let ((variants (children (select-children "variants" property))))
            ($ "g " (number->string (node-list-count variants)) "\\n"
                (for variants (lambda (variant) ($
                    "a " (name-of property) (variant-suffix property variant #t)
                    " " (scaly-var el) "." (model-item-name property variant #t)
                    " " (scaly-explicit el) "." (name-of property)
                    " " (scaly-validated (% "type" variant) (or (% "ref" variant) (% "ref" property)))
                    " " (scaly-declared variant)
                    "\\n")))))
        ($ (if (true? "iscollection" property) "c " "s ")
            (name-of property)
            " " (scaly-var el) "." (escape-csharp-keyword (name-of property))
            " " (scaly-explicit el) "." (name-of property)
            " " (scaly-validated (% "type" property) (% "ref" property))
            " " (scaly-declared (node-list-first (variants-of property)))
            " " (if (true? "notnull" property) "1" "0")
            "\\n")))

; A type's entry, and those of the types nested in it.
(define (scaly-type el) ($
"    record(out, \"@@T:" (scaly-type-key el) "\\n" (scaly-var el) "\\n"
        (for (node-list-filter
                (lambda (p) (not (and (scaly-resource? el) (resource-property? p))))
                (children (select-children "properties" el)))
            (lambda (property) (scaly-member property el)))
"\\n\")
"
        (for-children-of (select-children "elements" el) scaly-type)))

(define (scaly-codeset codeset) ($
"    record(out, \"@@C:" (% "id" codeset) "\\n"
        (for (children (select-children "codes" codeset))
            (lambda (code) ($ (scaly-literal (% "value" code)) "\\n")))
"\\n\")
"))

; The program: the model's text written and handed to the runtime.
(define (scaly-program-file)
    (let ((name (downcase-string (fhir-name))))
        (file ($ name ".scaly") ($
"; GENERATED by codegen/scaly.dsl from model/fhir.xml. Do not edit.
;
; " (fhir-name) " -- a FHIR R5 server, the drop-in replacement of the C# server
; upstream's generator writes from the same model. All of it that knows no
; resource type is the package fhir; what is here is the model
; (" name "/Model.scaly, " name "/Schema.scaly) and the handing over.
;
;   scaly build " name ".scaly -o build/" name "

package scaly 0.1.0
package pg 0.2.0
package fhir 0.1.0

define " name "
{
    module Model
    module Schema
}

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int mutable pg_pool, sqlite_thread, tds_pool
{
    var text Array[u8]()
    model_write(&" "text)
    schema_write(&" "text)
    serve_model(text.as_slice())
}
"))))

(define (scaly-model-file)
    (let* ((root (current-node))
           (active (node-list-filter active? (children (select-children "resources" root))))
           (active-names (map name-of (node-list->list active)))
           (unversioned-names (map name-of (node-list->list
                (node-list-filter (lambda (r) (not (history? r))) active)))))
        (file "Model.scaly" ($
"; GENERATED by codegen/scaly.dsl from model/fhir.xml. Do not edit.
;
; The model as the runtime reads it: ONE text of records, written into an
; array the program keeps for as long as it runs. A record begins with a
; line @@kind:key and holds what follows up to the next one, without
; its last line feed. The kinds:
;   =  what there is one of: types (the resource types the server stores,
;      separated by blanks, in the model's order), unversioned (those of
;      them that keep no history), route (the path every
;      route begins with), version (the one a database of this server is
;      at), capability (the CapabilityStatement, as upstream's
;      MetadataHandler serializes it)
;   T  a type's members: the name of its variable, then one line per member
;      (codegen/model.scm says what a line holds)
;   C  a code set's values, one per line
;   S  a resource type's search tables, one per line (codegen/search.scm)
;   R  its reference parameters, one per line: the parameter, the
;      reference's path in the resource, the active types it may point to
;   K  the columns it keeps beside its content, in the model's order, as
;      column:member:kind separated by commas (b a boolean, t a text, d an
;      instant, i an int, l a long, m a decimal)
;   N  its search parameters by name: a line each, the name and its table
;   O  what it can be sorted by, a line per key (see _sort below)
;   Q  the members a resource of it must have, separated by blanks
;   U  an upgrade step's actions beside its SQL, one per line (the steps'
;      versions, in order: =:upgrades)
;   P  its search parameters as the searchset Bundle upstream's
;      SearchParameterHandler answers

procedure record(mutable out: ref[Array[u8]], text: Slice[u8])
    out.append(text)

procedure model_write(mutable out: ref[Array[u8]])
{
    record(out, \"@@=:types\\n" (scaly-joined-with " " active-names) "\\n\")
    record(out, \"@@=:unversioned\\n" (scaly-joined-with " " unversioned-names) "\\n\")
    record(out, \"@@=:route\\n/" (downcase-string (fhir-name)) "\\n\")
    record(out, \"@@=:version\\n" (let ((v (% "version" root))) (if v v "0.0.0")) "\\n\")
    record(out, \"@@=:capability\\n" (string-replace (scaly-capability root) "\"" "\\\"") "\\n\")
"
            (for (node-list-filter
                    (lambda (r) (and (model? r) (not (string=? "Resource" (name-of r)))))
                    (children (select-children "resources" root)))
                scaly-type)
            (for (node-list-filter
                    (lambda (el) (not (string=? "Element" (name-of el))))
                    (children (select-children "elements" root)))
                scaly-type)
            (for (select-elements (descendants root) "codeset") scaly-codeset)
            (for active scaly-searches)
            (for active (lambda (r) (scaly-references r active-names)))
            (for active scaly-columns)
            (for active (lambda (r) (scaly-sorts r root)))
            (for active scaly-search-names)
            (for active scaly-required)
            (for active scaly-search-parameters)
            (scaly-upgrades root)
"}
"))))

; The upgrade steps of the model, in its order: the versions (=:upgrades),
; and for each what the server does beside the step's SQL (which is a
; script of its own, sql/DATABASE.upgrade.VERSION.sql), one a line:
;   newresource TYPE             the type's seed data put in
;   newsearch TYPE PARAMETER     the parameter's table made and filled
;   applybundle FILE             a bundle of the seed directory applied
;   datamigration CLASS          a migration written by hand for upstream
;                                (C#) -- this server has none and refuses
(define (scaly-upgrade-nodes root)
    (let ((upgrades (select-children "upgrades" root)))
        (if (node-list-empty? upgrades) '()
            (node-list->list (children (node-list-first upgrades))))))

(define (scaly-upgrade-action action)
    (case (gi action)
        (("newresource") ($ "newresource " (name-of (ref action)) "\\n"))
        (("newsearch")
            (let ((search (ref action)))
                ($ "newsearch " (name-of (parent (parent search))) " " (% "name" search) "\\n")))
        (("applybundle") ($ "applybundle " (% "file" action) "\\n"))
        (("datamigration")
            (let ((run (% "run" action)))
                (if (or (not run) (string=? run "both") (string=? run "upgrade"))
                    ($ "datamigration " (% "class" action) "\\n")
                    "")))
        (else "")))

(define (scaly-upgrades root)
    (let ((steps (scaly-upgrade-nodes root)))
        ($ "    record(out, \"@@=:upgrades\\n" (scaly-joined-with " " (map (lambda (u) (% "to" u)) steps)) "\\n\")
"
           (apply $ (map (lambda (u)
                ($ "    record(out, \"@@U:" (% "to" u) "\\n"
                   (apply $ (map scaly-upgrade-action (node-list->list (children u))))
                   "\\n\")
"))
                steps)))))

; Each database's scripts, as upstream's provider has them -- written as
; they are (schema-sql and its fellows answer what cannot be taken apart
; here to be made a Scaly string; tools/schema.sh makes records of them).
(define (scaly-script-files)
    (make directory path: "sql"
        (apply sosofo-append (map (lambda (db)
            (let ((name (case db ((PostgreSql) "postgresql") ((Sqlite) "sqlite") (else "sqlserver"))))
                (sosofo-append
                    (file ($ name ".schema.sql") (schema-sql db))
                    (file ($ name ".indexes.create.sql") (create-indexes-sql db))
                    (file ($ name ".indexes.drop.sql") (drop-indexes-sql db))
                    ; the SQL of every upgrade step (empty for one that only moves data)
                    (if (has-upgrades?)
                        (for-nodes (upgrade-list) (lambda (upgrade)
                            (file ($ name ".upgrade." (% "to" upgrade) ".sql")
                                  (upgrade-step-sql upgrade db))))
                        (empty-sosofo)))))
            '(PostgreSql Sqlite SqlServer)))))

; --- /metadata ---

(define (scaly-capability-resource resource)
    (let* ((rn (name-of resource))
           (has-history (history? resource))
           (searches-node (select-children "searches" resource))
           (all-searches (if (node-list-empty? searches-node) '()
                            (node-list->list (children (node-list-first searches-node)))))
           (served (filter search-is-served? all-searches)))
        ($ "{\"type\":\"" rn "\",\"interaction\":[{\"code\":\"read\"},"
           (if has-history "{\"code\":\"vread\"}," "")
           "{\"code\":\"update\"},{\"code\":\"patch\"},{\"code\":\"delete\"},{\"code\":\"create\"},{\"code\":\"search-type\"}"
           (if has-history ",{\"code\":\"history-instance\"},{\"code\":\"history-type\"}" "")
           "],\"versioning\":\"" (if has-history "versioned" "no-version") "\","
           "\"conditionalCreate\":true,\"conditionalUpdate\":true,\"conditionalDelete\":\"single\","
           "\"searchParam\":["
           (let loop ((ss served) (first #t))
               (if (null? ss) ""
                   ($ (if first "" ",")
                      "{\"name\":\"" (% "name" (car ss)) "\",\"type\":\"" (% "type" (car ss)) "\"}"
                      (loop (cdr ss) #f))))
           "]}")))

(define (scaly-capability root)
    ($ "{\"resourceType\":\"CapabilityStatement\",\"status\":\"active\",\"kind\":\"instance\",\"fhirVersion\":\"5.0.0\","
       "\"format\":[\"json\",\"xml\"],\"rest\":[{\"mode\":\"server\",\"resource\":["
       (let loop ((rs (node-list->list (node-list-filter active? (children (select-children "resources" root))))) (first #t))
           (if (null? rs) ""
               ($ (if first "" ",") (scaly-capability-resource (car rs)) (loop (cdr rs) #f))))
       "],\"interaction\":[{\"code\":\"transaction\"},{\"code\":\"batch\"}]}]}"))

; --- /SearchParameter ---

; One resource type's Bundle: a SearchParameter for every search the
; repository answers that has an expression (boilerplate.scm,
; boilerplate-search-parameter-handler). A type with none has no case: the
; handler answers the empty Bundle for it.
(define (scaly-search-parameters resource)
    (let* ((rn (name-of resource))
           (searches-node (select-children "searches" resource))
           (all-searches (if (node-list-empty? searches-node) '()
                            (node-list->list (children (node-list-first searches-node)))))
           (entries (let loop ((ss (filter search-is-served? all-searches)))
               (if (null? ss) '()
                   (let ((path (scaly-dot-path (search-path-parts (car ss)))))
                       (if path
                           (cons ($ "{\"resource\":{\"resourceType\":\"SearchParameter\",\"code\":\"" (% "name" (car ss))
                                    "\",\"base\":[\"" rn "\"],\"type\":\"" (% "type" (car ss))
                                    "\",\"expression\":\"" rn "." path "\"}}")
                                 (loop (cdr ss)))
                           (loop (cdr ss))))))))
        (if (null? entries) ""
            ($ "    record(out, \"@@P:" rn "\\n"
               (string-replace
                   ($ "{\"resourceType\":\"Bundle\",\"type\":\"searchset\",\"total\":" (number->string (length entries)) ",\"entry\":["
                      (let loop ((es entries) (first #t))
                          (if (null? es) "" ($ (if first "" ",") (car es) (loop (cdr es) #f))))
                      "]}")
                   "\"" "\\\"")
               "\\n\")
"))))

; --- the facts of a type the handlers and the repository ask for ---

(define (scaly-joined-with separator names)
    (if (null? names) ""
        ($ (car names) (apply $ (map (lambda (n) ($ separator n)) (cdr names))))))

(define (scaly-column-kind search)
    (let ((prop (search-property search)))
        (case (if prop (% "type" prop) "string")
            (("boolean") "b")
            (("instant") "d")
            (("integer" "positiveInt" "unsignedInt") "i")
            (("integer64") "l")
            (("decimal") "m")
            (else "t"))))

(define (scaly-columns resource)
    (let ((inline (node-list->list (inline-searches resource))))
        (if (null? inline) ""
            ($ "    record(out, \"@@K:" (name-of resource) "\\n"
               (scaly-joined-with ","
                   (map (lambda (s)
                            ($ (search-col s) ":" (or (search-fhir-field-name s) (% "name" s)) ":" (scaly-column-kind s)))
                        inline))
               "\\n\")
"))))

; The search parameters of a type by their names: the name and its table.
(define (scaly-search-names resource)
    ($ "    record(out, \"@@N:" (name-of resource) "\\n"
       (apply $ (map (lambda (s) ($ (% "name" s) " " (search-table-name s) "\\n"))
                     (append (node-list->list (inline-searches resource))
                             (node-list->list (table-searches resource)))))
       "\\n\")
"))

; --- _sort ---
;
; What a type can be sorted by, as upstream's BuildOrderBy has it: a line
; per key, the key and behind a blank the expression over the row `r2` --
; or `!` for a reference parameter, which upstream refuses with a hint at
; the chain. In upstream's order; the first line of a key is the one.
;   its own: a column, _lastUpdated, a date, a number, a string (of a
;     HumanName only family and given), a token
;   a chain: reference:Type.key for every active target of the reference's
;     first path -- its columns, _lastUpdated, its string, token, date and
;     number tables
;   a reverse chain: _has:Type:reference:key, where the model declares one
;     (a param with ref and chain below repos, for another type)

(define (scaly-quoted name) ($ "\\\"" name "\\\""))

(define (scaly-sort-table schema search)
    ($ (scaly-quoted schema) "." (search-table-name search)))

(define (scaly-sort-own resource search column order)
    ($ (% "name" search) " (SELECT x." column " FROM " (scaly-sort-table (name-of resource) search)
       " x WHERE x.resource_id = r2.id" order " LIMIT 1)\\n"))

(define (scaly-sortable-table? search)
    (let ((t (% "type" search)))
        (or (string=? "string" t) (string=? "token" t) (string=? "date" t) (string=? "number" t))))

(define (scaly-sort-chain resource ref-search)
    (let* ((paths-node (select-children "paths" ref-search))
           (path-nodes (if (node-list-empty? paths-node) (empty-node-list)
                          (select-children "path" (node-list-first paths-node))))
           (first-path (if (node-list-empty? path-nodes) #f (node-list-first path-nodes)))
           (targets-node (if first-path (select-children "targets" first-path) (empty-node-list)))
           (targets (if (node-list-empty? targets-node) '()
                        (node-list->list (children (node-list-first targets-node)))))
           (from ($ " FROM " (scaly-sort-table (name-of resource) ref-search) " src JOIN ")))
        (apply $ (map (lambda (tgt)
            (let* ((tgt-rn (% "resource" tgt))
                   (tgt-elem (if tgt-rn (element-with-id (downcase-string tgt-rn)) #f))
                   (key ($ (% "name" ref-search) ":" tgt-rn ".")))
                (if (and tgt-elem (active? tgt-elem))
                    ($ (apply $ (map (lambda (s)
                            ($ key (% "name" s) " (SELECT t." (scaly-quoted (search-col s)) from (scaly-quoted tgt-rn)
                               " t ON t.id = src.target_id WHERE src.resource_id = r2.id LIMIT 1)\\n"))
                            (node-list->list (inline-searches tgt-elem))))
                       key "_lastUpdated (SELECT t.last_updated" from (scaly-quoted tgt-rn)
                       " t ON t.id = src.target_id WHERE src.resource_id = r2.id LIMIT 1)\\n"
                       (apply $ (map (lambda (s)
                            ($ key (% "name" s) " (SELECT c." (if (string=? "date" (% "type" s)) "value_low" "value")
                               from (scaly-sort-table tgt-rn s)
                               " c ON c.resource_id = src.target_id WHERE src.resource_id = r2.id LIMIT 1)\\n"))
                            (filter scaly-sortable-table? (node-list->list (table-searches tgt-elem))))))
                    "")))
            targets))))

(define (scaly-sort-reverse resource root)
    (let* ((rn-lc (downcase-string (name-of resource)))
           (repos-nl (select-children "repos" root))
           (repo-nl (if (node-list-empty? repos-nl) (empty-node-list)
                        (node-list-filter
                            (lambda (r) (let ((at (% "ref" r))) (if at (string=? (downcase-string at) rn-lc) #f)))
                            (select-children "repo" (node-list-first repos-nl)))))
           (params (if (node-list-empty? repo-nl) '()
                       (node-list->list (select-descendants "param" (node-list-first repo-nl))))))
        (apply $ (map (lambda (param)
            (let* ((chain-attr (% "chain" param))
                   (ref-attr (% "ref" param))
                   (ref-search (if (and chain-attr ref-attr) (element-with-id ref-attr) #f))
                   (src-res (if ref-search (parent (parent ref-search)) #f))
                   (src-id (if src-res (% "id" src-res) #f))
                   (chain-search (if ref-search (element-with-id chain-attr) #f)))
                (if (and src-id (not (string=? src-id rn-lc)) chain-search
                         (% "type" chain-search) (scaly-sortable-table? chain-search))
                    (let* ((src-rn (name-of src-res))
                           (key ($ "_has:" src-rn ":" (% "name" ref-search) ":" (% "name" chain-search)))
                           (through ($ " t JOIN " (scaly-sort-table src-rn ref-search)
                                       " rs ON rs.resource_id = t.id WHERE rs.target_id = r2.id LIMIT 1)\\n")))
                        (cond
                            ((search-is-inline? chain-search)
                                ($ key " (SELECT t." (scaly-quoted (search-col chain-search)) " FROM " (scaly-quoted src-rn) through))
                            ((search-is-last-updated? chain-search)
                                ($ key " (SELECT t.last_updated FROM " (scaly-quoted src-rn) through))
                            (else
                                ($ key " (SELECT c." (if (string=? "date" (% "type" chain-search)) "value_low" "value")
                                   " FROM " (scaly-sort-table src-rn ref-search) " rs JOIN " (scaly-sort-table src-rn chain-search)
                                   " c ON c.resource_id = rs.resource_id WHERE rs.target_id = r2.id LIMIT 1)\\n"))))
                    "")))
            params))))

(define (scaly-sorts resource root)
    (let* ((inline (node-list->list (inline-searches resource)))
           (tables (filter (lambda (s) (member (% "type" s) '("string" "token" "date" "reference" "number" "quantity" "uri")))
                           (node-list->list (table-searches resource))))
           (of-type (lambda (type) (filter (lambda (s) (string=? type (% "type" s))) tables)))
           (strings (of-type "string"))
           (names (lambda (field) (filter (lambda (s) (and (search-is-humanname? s) (equal? field (search-humanname-field s)))) strings)))
           (references (of-type "reference"))
           (own (lambda (column) (lambda (s) (scaly-sort-own resource s column "")))))
        ($ "    record(out, \"@@O:" (name-of resource) "\\n"
           (apply $ (map (lambda (s) ($ (% "name" s) " r2." (scaly-quoted (search-col s)) "\\n")) inline))
           "_lastUpdated r2.last_updated\\n"
           (apply $ (map (lambda (s) (scaly-sort-own resource s "value_low" (if (search-is-date-list? s) " ORDER BY x.id" "")))
                         (filter (lambda (s) (not (search-is-inline-instant? s))) (of-type "date"))))
           (apply $ (map (own "value") (of-type "number")))
           (apply $ (map (lambda (s) ($ (% "name" s) " (SELECT LOWER(x.value) FROM " (scaly-sort-table (name-of resource) s)
                                        " x WHERE x.resource_id = r2.id LIMIT 1)\\n"))
                         (append (names "family") (names "given")
                                 (filter (lambda (s) (not (search-is-humanname? s))) strings))))
           (apply $ (map (own "value") (filter (lambda (s) (not (search-is-inline? s))) (of-type "token"))))
           (apply $ (map (lambda (s) (scaly-sort-chain resource s)) references))
           (apply $ (map (lambda (s) ($ (% "name" s) " !\\n")) references))
           (scaly-sort-reverse resource root)
           "\\n\")
")))

(define (scaly-required resource)
    (let* ((props-node (select-children "properties" resource))
           (all-props (if (node-list-empty? props-node) '()
                          (node-list->list (children (node-list-first props-node)))))
           (required (filter (lambda (p) (and (true? "notnull" p) (not (string=? "id" (% "name" p))))) all-props)))
        (if (null? required) ""
            ($ "    record(out, \"@@Q:" (name-of resource) "\\n" (scaly-joined-with " " (map (lambda (p) (% "name" p)) required)) "\\n\")
"))))
