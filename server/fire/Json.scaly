; Bytes appended to a buffer: text and decimal numbers.

; s appended to out. (`append`, not `add`: of a call to `add` the compiler
; knows the first of its three routines, the one that KEEPS its argument,
; and a routine that passes a view on to it could not be handed a buffer of
; its caller's own.)
procedure put_bytes(mutable out: ref[Array[u8]], s: Slice[u8])
    out.append(s)

; v in decimal.
procedure put_decimal(mutable out: ref[Array[u8]], v: i64)
{
    if v < 0
    {
        out.add(45 as u8)
        return put_decimal(out, (0 as i64) - v)
    }
    if v >= 10
        put_decimal(out, v / 10)
    out.add(((v % 10) + 48) as u8)
}
