; JSON as upstream stores and sends it: the text System.Text.Json writes for
; a node tree -- no white space, members in their order, a number as its
; source text, and in a string everything but plain Basic Latin escaped
; (the default encoder: a short escape where JSON has one except for the
; quote, \uXXXX in upper case for the rest -- the quote, & ' + < > `, the
; controls, DEL and every character beyond ASCII, as surrogate pairs past
; the BMP). The stored bytes are these bytes; either server reads what the
; other wrote.

use json.Value.JsonValue
use json.Value.JsonMember
use json.Value.JsonObject
use json.Value.JsonString

procedure put_byte(mutable out: ref[Array[u8]], b: u8)
    out.add(b)

procedure put_bytes(mutable out: ref[Array[u8]], s: Slice[u8])
    out.add(s)

; v in decimal.
procedure put_decimal(mutable out: ref[Array[u8]], v: i64)
{
    if v < 0
    {
        out.add(45 as u8)
        return put_decimal(out, (0 as i64) - v)
    }
    if v >= 10
        put_decimal(out, v / 10)
    out.add(((v % 10) + 48) as u8)
}

function hex_upper(v: int) returns u8
{
    if v < 10
        return (v + 48) as u8
    (v + 55) as u8
}

; \uXXXX for a UTF-16 code unit.
procedure put_unit(mutable out: ref[Array[u8]], unit: int)
{
    put_bytes(out, "\\u")
    put_byte(out, hex_upper((unit >> 12) & 15))
    put_byte(out, hex_upper((unit >> 8) & 15))
    put_byte(out, hex_upper((unit >> 4) & 15))
    put_byte(out, hex_upper(unit & 15))
}

procedure put_ascii(mutable out: ref[Array[u8]], c: int)
{
    match c
        case 92: return put_bytes(out, "\\\\")
        case 8: return put_bytes(out, "\\b")
        case 9: return put_bytes(out, "\\t")
        case 10: return put_bytes(out, "\\n")
        case 12: return put_bytes(out, "\\f")
        case 13: return put_bytes(out, "\\r")
    if c < 32 or c = 127 or c = 34 or c = 38 or c = 39 or c = 43 or c = 60 or c = 62 or c = 96
        return put_unit(out, c)
    put_byte(out, c as u8)
}

; s (UTF-8) as a string literal.
procedure write_json_string(mutable out: ref[Array[u8]], s: Slice[u8])
{
    put_byte(out, 34)
    var i: size_t 0
    while i < s.length
    {
        let c s[i] as int
        if c < 128
        {
            put_ascii(out, c)
            i := i + 1
            continue
        }
        ; a sequence that is not UTF-8 goes out as U+FFFD, byte by byte
        var cp 65533
        var n: size_t 1
        if c >= 194 and c < 224 and i + 1 < s.length
        {
            cp := ((c & 31) << 6) | ((s[i + 1] as int) & 63)
            n := 2
        }
        if c >= 224 and c < 240 and i + 2 < s.length
        {
            cp := ((c & 15) << 12) | (((s[i + 1] as int) & 63) << 6) | ((s[i + 2] as int) & 63)
            n := 3
        }
        if c >= 240 and c < 245 and i + 3 < s.length
        {
            cp := ((c & 7) << 18) | (((s[i + 1] as int) & 63) << 12) | (((s[i + 2] as int) & 63) << 6) | ((s[i + 3] as int) & 63)
            n := 4
        }
        if cp < 65536
            put_unit(out, cp)
        else
        {
            let v cp - 65536
            put_unit(out, 55296 + (v >> 10))
            put_unit(out, 56320 + (v & 1023))
        }
        i := i + n
    }
    put_byte(out, 34)
}

; v as System.Text.Json writes it.
procedure write_json(mutable out: ref[Array[u8]], v: JsonValue)
{
    if v.is_null()
        return put_bytes(out, "null")
    if v.is_bool()
    {
        if v.as_bool()
            return put_bytes(out, "true")
        return put_bytes(out, "false")
    }
    if v.is_number()
        return put_bytes(out, v.number_text())
    if v.is_text()
        return write_json_string(out, v.text())
    if v.is_array()
    {
        put_byte(out, 91)
        var i: size_t 0
        while i < v.length()
        {
            if i > 0
                put_byte(out, 44)
            write_json(out, v.item(i))
            i := i + 1
        }
        return put_byte(out, 93)
    }
    put_byte(out, 123)
    var k: size_t 0
    while k < v.length()
    {
        if k > 0
            put_byte(out, 44)
        write_json_string(out, v.key_at(k))
        put_byte(out, 58)
        write_json(out, v.value_at(k))
        k := k + 1
    }
    put_byte(out, 125)
}

; A string value over bytes that outlive it.
function json_text(bytes: Slice[u8]) returns JsonValue
    JsonValue.Text(JsonString(bytes, false))

; An object without members, to be filled by with_member.
procedure json_object(page: ref[Page]) returns JsonValue
    JsonValue.Object(JsonObject(allocate_slice[JsonMember]^page(page, 0)))

; The object with its member `key` set to value: in the member's place when
; it has one, else as its last (what an assignment to a JsonObject's index
; does upstream). The new member list lies on page.
procedure with_member(page: ref[Page], object: JsonValue, key: Slice[u8], value: JsonValue) returns JsonValue
{
    choose object
        when o: Object
        {
            let n o.members.length
            var room allocate_slice[JsonMember]^page(page, n + 1)
            var found false
            var i: size_t 0
            while i < n
            {
                if found = false and o.members[i].key.equals(key)
                {
                    room.put(i, JsonMember(key, value, false))
                    found := true
                }
                else
                    room.put(i, o.members[i])
                i := i + 1
            }
            if found
                return JsonValue.Object(JsonObject(room.slice_to(n)))
            room.put(n, JsonMember(key, value, false))
            return JsonValue.Object(JsonObject(room))
        }
        else
            return object
}
