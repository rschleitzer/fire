; What is common to every stored resource: which types the server has and
; what columns each keeps beside its content, how a write or a read ends,
; and the bytes a version is stored as (upstream's InjectMeta and
; ExtractInlineParams).

use json.Value.JsonValue
use json.Writer.JsonWriter
use fire.Instant.Instant

define STORED: int 0
define NOT_FOUND: int 1
define CONFLICT: int 2
define FAILED: int 3
define UNREADABLE: int 4
define REFUSED: int 5
define BROKEN: int 6

; How a write or a read ended (STORED, NOT_FOUND, CONFLICT -- the version
; an If-Match named is not the current one --, FAILED: the database did not
; answer, UNREADABLE: the data of a type that keeps it apart is no
; base64), and the version it wrote or found with the second it is from.
define StoreResult (status: int, version_id: i64, seconds: i64)

; The resource types the server stores, separated by blanks.
function resource_types() returns Slice[u8]
    "Binary Observation Patient Practitioner Provenance"

; The columns a type keeps beside its content, in the table's order, as
; name:kind separated by commas -- b a boolean, t a text, d an instant.
function inline_columns(type: Slice[u8]) returns Slice[u8]
{
    if type.equals("Observation")
        return "status:t"
    if type.equals("Patient")
        return "active:b,gender:t"
    if type.equals("Practitioner")
        return "gender:t,active:b"
    if type.equals("Provenance")
        return "recorded:d"
    ""
}

; The i-th entry of a list separated by `separator`; empty past its end.
function entry(list: Slice[u8], separator: u8, i: size_t) returns Slice[u8]
{
    var at: size_t 0
    var k: size_t 0
    while at <= list.length
    {
        var end at
        while end < list.length and list[end] <> separator
            end := end + 1
        if k = i
            return list.subslice(at, end)
        k := k + 1
        at := end + 1
    }
    list.slice_to(0)
}

; The name of the column entry name:kind.
function column_name(column: Slice[u8]) returns Slice[u8]
    column.slice_to(column.length - 2)

; The resource `root` with its id, meta.versionId and meta.lastUpdated set
; -- each in its place when the member is there, else as the last --,
; appended to content as it is stored: the bytes System.Text.Json writes.
procedure write_resource(root: JsonValue, id: Slice[u8], version_id: i64, now: Instant, mutable content: ref[Array[u8]])
{
    var version Array[u8]()
    put_decimal(&version, version_id)
    var last_updated Array[u8]()
    put_last_updated(&last_updated, now)
    var meta root.get("meta")
    if meta.is_object() = false
        meta := JsonValue.empty_object()
    meta := meta.with_member("versionId", JsonValue.of_text(version.as_slice()))
    meta := meta.with_member("lastUpdated", JsonValue.of_text(last_updated.as_slice()))
    var resource root.with_member("id", JsonValue.of_text(id))
    resource := resource.with_member("meta", meta)
    var w JsonWriter()
    w.value_dotnet(resource)
    content.add(w.bytes())
}
