; The handlers of a resource type, as upstream's answer for each of its
; types: create, read, version read, update, delete. The type is the path's
; segment after /fire/; the routes exist for the types the server stores.

use http.Request.Request
use http.Response.Response
use http.Router.Router
use json.Value.JsonValue
use json.Writer.JsonWriter
use fire.Resource.StoreResult

; The routes of every resource type; the patterns lie on page.
procedure add_resource_routes(mutable app: ref[Router], page: ref[Page])
{
    let types resource_types()
    var i: size_t 0
    while entry(types, 32, i).length > 0
    {
        let type entry(types, 32, i)
        app.get(pattern(page, type, ""), &resource_search_get)
        app.post(pattern(page, type, "/_search"), &resource_search_post)
        app.post(pattern(page, type, ""), &resource_post)
        app.get(pattern(page, type, "/$autocomplete"), &resource_autocomplete_get)
        app.get(pattern(page, type, "/{id}"), &resource_read)
        app.get(pattern(page, type, "/{id}/_history/{vid}"), &resource_vread)
        app.get(pattern(page, type, "/{id}/_history"), &resource_history_get)
        app.get(pattern(page, type, "/_history"), &resource_history_get)
        app.put(pattern(page, type, "/{id}"), &resource_put)
        app.delete(pattern(page, type, "/{id}"), &resource_remove)
        app.put(pattern(page, type, ""), &resource_put_conditional)
        app.patch(pattern(page, type, "/{id}"), &resource_patch)
        app.post(pattern(page, type, "/{id}/$undelete"), &resource_undelete)
        app.post(pattern(page, type, "/{id}/_rollback/{vid}"), &resource_rollback_post)
        app.put(pattern(page, type, "/_history/{id}"), &resource_import)
        app.delete(pattern(page, type, ""), &resource_remove_conditional)
        app.post(pattern(page, type, "/{id}"), &resource_post_instance)
        i := i + 1
    }
}

; <route>/<type><rest>, on page (the route is the model's: /fire).
procedure pattern(page: ref[Page], type: Slice[u8], rest: Slice[u8]) returns Slice[u8]
{
    let prefix model_route()
    var p allocate_slice[u8]^page(page, prefix.length + 1 + type.length + rest.length)
    var at: size_t 0
    var i: size_t 0
    while i < prefix.length
    {
        p.put(at, prefix[i])
        at := at + 1
        i := i + 1
    }
    p.put(at, 47 as u8)
    at := at + 1
    i := 0
    while i < type.length
    {
        p.put(at, type[i])
        at := at + 1
        i := i + 1
    }
    i := 0
    while i < rest.length
    {
        p.put(at, rest[i])
        at := at + 1
        i := i + 1
    }
    p
}

; The resource type a request's path names: /fire/<type>...
function type_of(req: ref[Request]) returns Slice[u8]
{
    let path req.path
    let from model_route().length + 1
    var end from
    while end < path.length and path[end] <> 47
        end := end + 1
    path.subslice(from, end)
}

; Location (with a host), ETag and Last-Modified for a version.
procedure version_fields(mutable res: ref[Response], host: Slice[u8], type: Slice[u8], id: Slice[u8], version_id: i64, seconds: i64)
{
    var version Array[u8]()
    put_decimal(&version, version_id)
    if host.length > 0
    {
        var location Array[u8]()
        put_bytes(&location, "http://")
        location.add(host)
        put_bytes(&location, model_route())
        put_bytes(&location, "/")
        location.add(type)
        put_bytes(&location, "/")
        location.add(id)
        put_bytes(&location, "/_history/")
        location.add(version.as_slice())
        res.header("Location", location.as_slice())
    }
    var etag Array[u8]()
    put_bytes(&etag, "W/\"")
    etag.add(version.as_slice())
    put_bytes(&etag, "\"")
    res.header("ETag", etag.as_slice())
    var date u8[29]
    let d Slice[u8](29, &date[0])
    format_date(d, seconds)
    res.header("Last-Modified", d)
}

; The Provenance a write brings along in its X-Provenance field, as
; upstream's HandlePrefer records it: what the field holds, made a
; Provenance whose one target is the resource just written, and created
; without a check. A field that is no JSON object, and a Provenance the
; store does not take, are passed over in silence.
procedure record_provenance(req: ref[Request], content: Slice[u8]) mutable pg_pool
{
    let field trim(req.header("x-provenance"))
    if field.length = 0 or known_type("Provenance") = false
        return
    let given JsonValue.parse(field)
    let written JsonValue.parse(content)
    if given.ok() = false or given.value.is_object() = false or written.ok() = false
        return
    let type written.value.get("resourceType")
    let id written.value.get("id")
    if type.is_text() = false or id.is_text() = false
        return
    var target Array[u8]()
    put_bytes(&target, "[{\"reference\":\"")
    put_bytes(&target, type.text())
    put_bytes(&target, "/")
    put_bytes(&target, id.text())
    put_bytes(&target, "\"}]")
    let targets JsonValue.parse(target.as_slice())
    if targets.ok() = false
        return
    let provenance given.value.with_member("resourceType", JsonValue.of_text("Provenance")).with_member("target", targets.value)
    var id_bytes u8[36]
    var new_id Slice[u8](36, &id_bytes[0])
    if new_uuid(new_id) = false
        return
    var stored Array[u8]()
    resource_create(0, "Provenance", provenance, new_id, false, &stored)
}

; The body of a write's answer, as the Prefer field asks for it -- after the
; Provenance the request brought along is recorded.
procedure send_stored(req: ref[Request], mutable res: ref[Response], content: Slice[u8]) mutable pg_pool
{
    record_provenance(req, content)
    let prefer trim(req.header("prefer"))
    if prefer.equals("return=minimal")
        return res.send("", "")
    if prefer.equals("return=OperationOutcome")
    {
        var outcome Array[u8]()
        write_outcome(&outcome, "information", "informational", "Operation successful")
        return send_resource(res, outcome.as_slice())
    }
    send_resource(res, content)
}

; The version a conditional field names (W/"3", "3", 3); 0 when none.
function version_of(field: Slice[u8]) returns i64
{
    var at: size_t 0
    if field.length >= 2 and field[0] = 87 and field[1] = 47
        at := 2
    if at < field.length and field[at] = 34
        at := at + 1
    digits_of(field.slice_from(at))
}

procedure not_found(mutable res: ref[Response], type: Slice[u8], id: Slice[u8], version: Slice[u8])
{
    var message Array[u8]()
    message.add(type)
    put_bytes(&message, "/")
    message.add(id)
    if version.length > 0
    {
        put_bytes(&message, "/_history/")
        message.add(version)
    }
    put_bytes(&message, " not found")
    send_error(res, "not-found", message.as_slice(), 404)
}

procedure type_mismatch(mutable res: ref[Response], type: Slice[u8], got: Slice[u8])
{
    var message Array[u8]()
    put_bytes(&message, "Resource type mismatch: expected ")
    message.add(type)
    put_bytes(&message, ", got ")
    message.add(got)
    send_error(res, "invalid", message.as_slice(), 400)
}

; POST /fire/<type>
procedure resource_post(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    let parsed JsonValue.parse(req.body)
    if parsed.ok() = false or parsed.value.is_object() = false
        return send_error(res, "invalid", "Invalid JSON", 400)
    let root parsed.value
    let resource_type root.get("resourceType")
    if resource_type.is_text() = false
        return send_error(res, "invalid", "Missing required field: resourceType", 400)
    if resource_type.text().equals(type) = false
        return type_mismatch(res, type, resource_type.text())

    var outcome Array[u8]()
    if acceptable(type, root, &outcome) = false
    {
        res.set_status(400)
        return send_resource(res, outcome.as_slice())
    }

    ; conditional create: If-None-Exist names a search; one match is the
    ; answer, more than one a refusal
    let if_none_exist trim(req.header("if-none-exist"))
    if if_none_exist.length > 0
    {
        var criteria if_none_exist
        if criteria[0] = 63
            criteria := criteria.slice_from(1)
        var text Array[u8]()
        var cells Array[i64]()
        parse_pairs(criteria, &text, &cells)
        var found Array[u8]()
        var rows Array[i64]()
        var problem Array[u8]()
        let matches resource_search(0, type, text.as_slice(), cells.as_slice(), 2, 0, &found, &rows, &problem)
        if matches.status = FAILED
            return send_unavailable(res)
        if matches.status <> STORED
            return send_error(res, "exception", "An unexpected internal error occurred.", 500)
        if matches.version_id = 1
            return send_resource(res, found.as_slice().subslice(rows[2] as size_t, (rows[2] + rows[3]) as size_t))
        if matches.version_id > 1
            return send_error(res, "duplicate", "Multiple matches found for conditional create", 412)
    }

    var id_bytes u8[36]
    var id Slice[u8](36, &id_bytes[0])
    if new_uuid(id) = false
        return send_error(res, "exception", "An unexpected internal error occurred.", 500)
    var content Array[u8]()
    let stored resource_create(0, type, root, id, false, &content)
    if stored.status = UNREADABLE
        return send_error(res, "invalid", "The input is not a valid Base-64 string as it contains a non-base 64 character, more than two padding characters, or an illegal character among the padding characters.", 400)
    if stored.status <> STORED
        return send_unavailable(res)
    res.set_status(201)
    version_fields(res, trim(req.header("host")), type, id, stored.version_id, stored.seconds)
    send_stored(req, res, content.as_slice())
}

; GET /fire/<type>/{id}
procedure resource_read(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    let id req.param("id")
    var content Array[u8]()
    let row resource_select(0, type, id, 0, &content)
    if row.status = FAILED
        return send_unavailable(res)
    if row.status = NOT_FOUND
    {
        if resource_is_deleted(0, type, id)
            return send_error(res, "deleted", "Resource has been deleted", 410)
        return not_found(res, type, id, "")
    }
    let if_none_match trim(req.header("if-none-match"))
    if if_none_match.length > 0 and version_of(if_none_match) = row.version_id
    {
        res.set_status(304)
        return res.send("", "")
    }
    version_fields(res, "", type, id, row.version_id, row.seconds)
    if send_raw(type, req, res, content.as_slice())
        return
    send_resource(res, content.as_slice())
}

; GET /fire/<type>/{id}/_history/{vid}
procedure resource_vread(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    let id req.param("id")
    let vid req.param("vid")
    var all_digits vid.length > 0 and vid.length < 10
    var i: size_t 0
    while i < vid.length
    {
        if vid[i] < 48 or vid[i] > 57
            all_digits := false
        i := i + 1
    }
    if all_digits = false
        return send_error(res, "invalid", "Invalid version id", 400)
    var content Array[u8]()
    var row StoreResult(NOT_FOUND, 0, 0)
    if digits_of(vid) > 0
        row := resource_select(0, type, id, digits_of(vid), &content)
    if row.status = FAILED
        return send_unavailable(res)
    if row.status = NOT_FOUND
        return not_found(res, type, id, vid)
    version_fields(res, "", type, id, row.version_id, row.seconds)
    if send_raw(type, req, res, content.as_slice())
        return
    send_resource(res, content.as_slice())
}

; Letters, digits, '-' and '.', at most 64 of them.
function valid_id(id: Slice[u8]) returns bool
{
    if id.length > 64
        return false
    var i: size_t 0
    while i < id.length
    {
        let c id[i]
        if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c = 45 or c = 46
            i := i + 1
        else
            return false
    }
    true
}

; PUT /fire/<type>/{id}
procedure resource_put(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    let id req.param("id")
    if valid_id(id) = false
        return send_error(res, "invalid", "Invalid resource ID format", 400)
    let parsed JsonValue.parse(req.body)
    if parsed.ok() = false or parsed.value.is_object() = false
        return send_error(res, "invalid", "Invalid JSON", 400)
    let root parsed.value
    if root.get("resourceType").text().equals(type) = false
        return type_mismatch(res, type, root.get("resourceType").text())
    let body_id root.get("id")
    if body_id.is_text() and body_id.text().equals(id) = false
    {
        var message Array[u8]()
        put_bytes(&message, "Resource ID in body (")
        message.add(body_id.text())
        put_bytes(&message, ") does not match URL ID (")
        message.add(id)
        put_bytes(&message, ")")
        return send_error(res, "invalid", message.as_slice(), 400)
    }

    var outcome Array[u8]()
    if acceptable(type, root, &outcome) = false
    {
        res.set_status(400)
        return send_resource(res, outcome.as_slice())
    }

    var content Array[u8]()
    var stored resource_update(0, type, root, id, version_of(trim(req.header("if-match"))), &content)
    if stored.status = CONFLICT
        return send_error(res, "conflict", "Version conflict", 409)
    if stored.status = UNREADABLE
        return send_error(res, "invalid", "The input is not a valid Base-64 string as it contains a non-base 64 character, more than two padding characters, or an illegal character among the padding characters.", 400)
    if stored.status = NOT_FOUND
    {
        ; update as create: a PUT to an id that is not there creates it
        stored := resource_create(0, type, root, id, true, &content)
        if stored.status = STORED
        {
            res.set_status(201)
            version_fields(res, trim(req.header("host")), type, id, stored.version_id, stored.seconds)
            return send_stored(req, res, content.as_slice())
        }
    }
    if stored.status <> STORED
        return send_unavailable(res)
    version_fields(res, "", type, id, stored.version_id, stored.seconds)
    send_stored(req, res, content.as_slice())
}

; PUT /fire/<type>?<criteria>: the conditional update -- the one resource the
; criteria find is replaced, with none the resource is created, more than
; one is refused. As upstream's ConditionalUpdate; what it lets fail
; without an answer of its own (a search it refuses, data that is no
; base64) is the unexpected error here too.
procedure resource_put_conditional(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    if req.query.length = 0
        return send_error(res, "invalid", "Conditional update requires search parameters", 400)
    let parsed JsonValue.parse(req.body)
    if parsed.ok() = false or parsed.value.is_object() = false
        return send_error(res, "invalid", "Invalid JSON", 400)
    let root parsed.value
    if root.get("resourceType").text().equals(type) = false
        return type_mismatch(res, type, root.get("resourceType").text())
    var outcome Array[u8]()
    if acceptable(type, root, &outcome) = false
    {
        res.set_status(400)
        return send_resource(res, outcome.as_slice())
    }

    var text Array[u8]()
    var cells Array[i64]()
    parse_pairs(req.query, &text, &cells)
    var found Array[u8]()
    var rows Array[i64]()
    var problem Array[u8]()
    let matches resource_search(0, type, text.as_slice(), cells.as_slice(), 2, 0, &found, &rows, &problem)
    if matches.status = FAILED
        return send_unavailable(res)
    if matches.status <> STORED
        return send_error(res, "exception", "An unexpected internal error occurred.", 500)
    if matches.version_id > 1
        return send_error(res, "multiple-matches", "Multiple matches found for conditional update", 412)

    var content Array[u8]()
    if matches.version_id = 1
    {
        var existing Array[u8]()
        put_bytes(&existing, found.as_slice().subslice(rows[0] as size_t, (rows[0] + rows[1]) as size_t))
        let stored resource_update(0, type, root, existing.as_slice(), version_of(trim(req.header("if-match"))), &content)
        if stored.status = CONFLICT
            return send_error(res, "conflict", "Version conflict", 409)
        if stored.status = FAILED
            return send_unavailable(res)
        if stored.status <> STORED
            return send_error(res, "exception", "An unexpected internal error occurred.", 500)
        version_fields(res, "", type, existing.as_slice(), stored.version_id, stored.seconds)
        return send_stored(req, res, content.as_slice())
    }

    ; no match: created, under the id the resource names or a new one
    var id_bytes u8[36]
    var id Slice[u8](36, &id_bytes[0])
    var named false
    if root.get("id").is_text()
    {
        id := root.get("id").text()
        named := true
    }
    else if new_uuid(id) = false
        return send_error(res, "exception", "An unexpected internal error occurred.", 500)
    let stored resource_create(0, type, root, id, named, &content)
    if stored.status = FAILED
        return send_unavailable(res)
    if stored.status <> STORED
        return send_error(res, "exception", "An unexpected internal error occurred.", 500)
    res.set_status(201)
    version_fields(res, trim(req.header("host")), type, id, stored.version_id, stored.seconds)
    send_stored(req, res, content.as_slice())
}

; DELETE /fire/<type>?<criteria>: the conditional delete -- everything the
; criteria find is deleted. As upstream's ConditionalDelete.
procedure resource_remove_conditional(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    if req.query.length = 0
        return send_error(res, "invalid", "Conditional delete requires search parameters", 400)
    var text Array[u8]()
    var cells Array[i64]()
    parse_pairs(req.query, &text, &cells)
    var found Array[u8]()
    var rows Array[i64]()
    var problem Array[u8]()
    let matches resource_search(0, type, text.as_slice(), cells.as_slice(), 2147483647, 0, &found, &rows, &problem)
    if matches.status = FAILED
        return send_unavailable(res)
    if matches.status <> STORED
        return send_error(res, "exception", "An unexpected internal error occurred.", 500)
    var i: size_t 0
    while i * 4 < rows.length
    {
        let id found.as_slice().subslice(rows[i * 4] as size_t, (rows[i * 4] + rows[i * 4 + 1]) as size_t)
        if resource_delete(0, type, id) = FAILED
            return send_unavailable(res)
        i := i + 1
    }
    res.set_status(204)
    res.send("", "")
}

; A string as ASP.NET's Results.Json writes it (System.Text.Json with the
; relaxed encoder, not the one a resource is written with): the quote and
; the backslash behind a backslash, a control character by its short form
; or \u00XX, what lies beyond the basic plane as its two surrogates --
; everything else as it is.
procedure put_relaxed(mutable out: ref[Array[u8]], s: Slice[u8])
{
    let hex: Slice[u8] "0123456789ABCDEF"
    out.add(34 as u8)
    var i: size_t 0
    while i < s.length
    {
        let c s[i]
        if c = 34 or c = 92
        {
            out.add(92 as u8)
            out.add(c)
            i := i + 1
            continue
        }
        if c < 32 or c = 127
        {
            out.add(92 as u8)
            if c = 8
                out.add(98 as u8)
            else if c = 9
                out.add(116 as u8)
            else if c = 10
                out.add(110 as u8)
            else if c = 12
                out.add(102 as u8)
            else if c = 13
                out.add(114 as u8)
            else
            {
                put_bytes(out, "u00")
                out.add(hex[(c / 16) as size_t])
                out.add(hex[(c % 16) as size_t])
            }
            i := i + 1
            continue
        }
        if c = 194 and i + 1 < s.length
        {
            ; U+0080 to U+009F: the second set of control characters
            let second s[i + 1]
            if second < 160
            {
                put_bytes(out, "\\u00")
                out.add(hex[(second / 16) as size_t])
                out.add(hex[(second % 16) as size_t])
                i := i + 2
                continue
            }
        }
        if c >= 240 and i + 3 < s.length
        {
            let b1 s[i + 1]
            let b2 s[i + 2]
            let b3 s[i + 3]
            let point (((c as i64) - 240) * 262144) + (((b1 as i64) - 128) * 4096) + (((b2 as i64) - 128) * 64) + ((b3 as i64) - 128) - 65536
            let high 55296 + (point / 1024)
            let low 56320 + (point % 1024)
            put_bytes(out, "\\u")
            out.add(hex[((high / 4096) % 16) as size_t])
            out.add(hex[((high / 256) % 16) as size_t])
            out.add(hex[((high / 16) % 16) as size_t])
            out.add(hex[(high % 16) as size_t])
            put_bytes(out, "\\u")
            out.add(hex[((low / 4096) % 16) as size_t])
            out.add(hex[((low / 256) % 16) as size_t])
            out.add(hex[((low / 16) % 16) as size_t])
            out.add(hex[(low % 16) as size_t])
            i := i + 4
            continue
        }
        out.add(c)
        i := i + 1
    }
    out.add(34 as u8)
}

; GET /fire/<type>/$autocomplete?<param>=<beginning>[&_autocomplete=<property>]:
; the values of the property (the parameter itself when none is named)
; among the resources the parameter finds, as a plain JSON array.
procedure resource_autocomplete_get(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    var text Array[u8]()
    var cells Array[i64]()
    parse_pairs(req.query, &text, &cells)
    var count: i64 -1
    var offset: i64 -1
    if whole_number(first_value(text.as_slice(), cells.as_slice(), "_count"))
    {
        count := whole_value(first_value(text.as_slice(), cells.as_slice(), "_count"))
        if count < 0
            count := 0
    }
    if whole_number(first_value(text.as_slice(), cells.as_slice(), "_offset"))
        offset := whole_value(first_value(text.as_slice(), cells.as_slice(), "_offset"))
    var param: Slice[u8] ""
    var value: Slice[u8] ""
    var property: Slice[u8] ""
    var named false
    var chosen false
    var i: size_t 0
    while i < pair_count(cells.as_slice())
    {
        let key pair_key(text.as_slice(), cells.as_slice(), i)
        if key.equals("_autocomplete")
        {
            if named = false
                property := pair_value(text.as_slice(), cells.as_slice(), i)
            named := true
        }
        else if chosen = false and key.equals("_count") = false and key.equals("_offset") = false
        {
            param := key
            value := pair_value(text.as_slice(), cells.as_slice(), i)
            chosen := true
        }
        i := i + 1
    }
    if chosen = false
        return send_error(res, "required", "A search parameter is required", 400)
    if named = false
        property := param
    var found Array[u8]()
    var rows Array[i64]()
    let status resource_autocomplete(type, param, value, property, count, offset, &found, &rows)
    ; a statement the database refuses is upstream's DbException: unavailable
    if status <> STORED
        return send_unavailable(res)
    var out Array[u8]()
    put_bytes(&out, "[")
    var r: size_t 0
    while r * 2 < rows.length
    {
        if r > 0
            put_bytes(&out, ",")
        put_relaxed(&out, found.as_slice().subslice(rows[r * 2] as size_t, (rows[r * 2] + rows[r * 2 + 1]) as size_t))
        r := r + 1
    }
    put_bytes(&out, "]")
    res.send("application/json; charset=utf-8", out.as_slice())
}

; POST /fire/<type>/{id}/$undelete: a deleted resource back, as upstream's
; UndeleteAsync -- the state its last history row holds (the DELETE row has
; what it was when it was deleted) as a new version. A resource that is
; there, or that never was, is not found.
procedure resource_undelete(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    let id req.param("id")
    var content Array[u8]()
    let stored undelete(type, id, &content)
    if stored.status = FAILED
        return send_unavailable(res)
    if stored.status <> STORED
    {
        var message Array[u8]()
        message.add(type)
        put_bytes(&message, "/")
        message.add(id)
        put_bytes(&message, " not found or not deleted")
        return send_error(res, "not-found", message.as_slice(), 404)
    }
    version_fields(res, "", type, id, stored.version_id, stored.seconds)
    send_resource(res, content.as_slice())
}

; A deleted resource back: the state of its last history row as a new
; version, into content. NOT_FOUND for one that is there or never was.
procedure undelete(type: Slice[u8], id: Slice[u8], mutable content: ref[Array[u8]]) returns StoreResult mutable pg_pool
{
    var current Array[u8]()
    let there resource_select(0, type, id, 0, &current)
    if there.status = FAILED
        return StoreResult(FAILED, 0, 0)
    if there.status = STORED
        return StoreResult(NOT_FOUND, 0, 0)
    var found Array[u8]()
    var rows Array[i64]()
    let last resource_history(0, type, id, 1, 0, &found, &rows)
    if last.status <> STORED
        return StoreResult(FAILED, 0, 0)
    if rows.length = 0
        return StoreResult(NOT_FOUND, 0, 0)
    let parsed JsonValue.parse(found.as_slice().subslice(rows[6] as size_t, (rows[6] + rows[7]) as size_t))
    if parsed.ok() = false or parsed.value.is_object() = false
        return StoreResult(FAILED, 0, 0)
    resource_create(0, type, parsed.value, id, true, content)
}

; POST /fire/<type>/{id}/_rollback/{vid}: the current version undone, when it
; is the one named. As upstream's Rollback.
procedure resource_rollback_post(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    let id req.param("id")
    let vid req.param("vid")
    if whole_number(vid) = false
        return send_error(res, "invalid", "Invalid version id", 400)
    var content Array[u8]()
    let result resource_rollback(0, type, id, whole_value(vid), &content)
    if result.status = FAILED
        return send_unavailable(res)
    if result.status <> STORED
    {
        var message Array[u8]()
        message.add(type)
        put_bytes(&message, "/")
        message.add(id)
        put_bytes(&message, " rollback failed")
        return send_error(res, "not-found", message.as_slice(), 404)
    }
    version_fields(res, "", type, id, result.version_id, result.seconds)
    send_resource(res, content.as_slice())
}

; PUT /fire/<type>/_history/{id}: a version taken in as it comes, as
; upstream's ImportVersion -- created under the id when there is none, else
; the next version. Nothing of it is checked; the answer is empty.
procedure resource_import(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    let id req.param("id")
    let parsed JsonValue.parse(req.body)
    if parsed.ok() = false or parsed.value.is_object() = false
        return send_error(res, "invalid", "Invalid JSON", 400)
    var current Array[u8]()
    let there resource_select(0, type, id, 0, &current)
    if there.status = FAILED
        return send_unavailable(res)
    var content Array[u8]()
    var stored StoreResult(FAILED, 0, 0)
    if there.status = STORED
        stored := resource_update(0, type, parsed.value, id, version_of(""), &content)
    else
        stored := resource_create(0, type, parsed.value, id, true, &content)
    if stored.status = UNREADABLE
        return send_error(res, "exception", "The input is not a valid Base-64 string as it contains a non-base 64 character, more than two padding characters, or an illegal character among the padding characters.", 500)
    if stored.status <> STORED
        return send_unavailable(res)
    res.set_status(200)
    res.send("", "")
}

; DELETE /fire/<type>/{id}
procedure resource_remove(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    let id req.param("id")
    let status resource_delete(0, type, id)
    if status = FAILED
        return send_unavailable(res)
    if status = NOT_FOUND
        return not_found(res, type, id, "")
    res.set_status(204)
    res.send("", "")
}

; POST /fire/<type>/{id}
procedure resource_post_instance(req: ref[Request], mutable res: ref[Response])
    send_error(res, "invalid", "POST to instance endpoint is not allowed", 405)

; One link of a bundle: relation and url.
procedure bundle_link(mutable w: ref[JsonWriter], relation: Slice[u8], url: Slice[u8])
{
    w.begin_object()
    w.key("relation")
    w.text(relation)
    w.key("url")
    w.text_dotnet(url)
    w.end_object()
}

; The links of a bundle that is one page of `total`: itself (the address
; and the query as it came), the next page when there is one, the one
; before when this is not the first.
procedure page_links(mutable w: ref[JsonWriter], address: Slice[u8], asked: Slice[u8], text: Slice[u8], cells: Slice[i64], total: i64, count: i64, offset: i64)
{
    var url Array[u8]()
    put_bytes(&url, address)
    if asked.length > 0
    {
        put_bytes(&url, "?")
        put_bytes(&url, asked)
    }
    w.begin_array()
    bundle_link(w, "self", url.as_slice())
    if offset + count < total
    {
        var next Array[u8]()
        put_bytes(&next, address)
        put_bytes(&next, "?")
        put_page_query(&next, text, cells, offset + count, count)
        bundle_link(w, "next", next.as_slice())
    }
    if offset > 0
    {
        var previous Array[u8]()
        put_bytes(&previous, address)
        put_bytes(&previous, "?")
        var back offset - count
        if back < 0
            back := 0
        put_page_query(&previous, text, cells, back, count)
        bundle_link(w, "previous", previous.as_slice())
    }
    w.end_array()
}

; GET /fire/<type>/{id}/_history and GET /fire/<type>/_history: the
; versions as a history Bundle.
procedure resource_history_get(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let type type_of(req)
    let id req.param("id")
    var text Array[u8]()
    var cells Array[i64]()
    parse_pairs(req.query, &text, &cells)
    var count: i64 20
    var offset: i64 0
    if whole_number(first_value(text.as_slice(), cells.as_slice(), "_count"))
    {
        count := whole_value(first_value(text.as_slice(), cells.as_slice(), "_count"))
        if count > 1000
            count := 1000
    }
    if whole_number(first_value(text.as_slice(), cells.as_slice(), "_offset"))
        offset := whole_value(first_value(text.as_slice(), cells.as_slice(), "_offset"))
    if count < 0 or offset < 0
        return send_error(res, "exception", "An unexpected internal error occurred.", 500)
    var found Array[u8]()
    var rows Array[i64]()
    let result resource_history(0, type, id, count, offset, &found, &rows)
    if result.status <> STORED
        return send_unavailable(res)
    if id.length > 0 and rows.length = 0
        return not_found(res, type, id, "")

    var base Array[u8]()
    put_bytes(&base, "http://")
    put_bytes(&base, trim(req.header("host")))
    put_bytes(&base, model_route())
    put_bytes(&base, "/")
    put_bytes(&base, type)
    var address Array[u8]()
    put_bytes(&address, base.as_slice())
    if id.length > 0
    {
        put_bytes(&address, "/")
        put_bytes(&address, id)
    }
    put_bytes(&address, "/_history")

    var w JsonWriter()
    w.begin_object()
    w.key("resourceType")
    w.text("Bundle")
    w.key("type")
    w.text("history")
    w.key("total")
    w.integer(result.version_id)
    w.key("link")
    page_links(&w, address.as_slice(), req.query, text.as_slice(), cells.as_slice(), result.version_id, count, offset)
    if rows.length > 0
    {
        w.key("entry")
        w.begin_array()
        var i: size_t 0
        while i * 8 < rows.length
        {
            let row_id found.as_slice().subslice(rows[i * 8] as size_t, (rows[i * 8] + rows[i * 8 + 1]) as size_t)
            let tombstone found.as_slice().subslice(rows[i * 8 + 4] as size_t, (rows[i * 8 + 4] + rows[i * 8 + 5]) as size_t).equals("TOMBSTONE")
            var full Array[u8]()
            put_bytes(&full, base.as_slice())
            put_bytes(&full, "/")
            put_bytes(&full, row_id)
            var relative Array[u8]()
            put_bytes(&relative, type)
            put_bytes(&relative, "/")
            put_bytes(&relative, row_id)
            w.begin_object()
            w.key("fullUrl")
            w.text_dotnet(full.as_slice())
            if tombstone = false
            {
                w.key("resource")
                w.raw(found.as_slice().subslice(rows[i * 8 + 6] as size_t, (rows[i * 8 + 6] + rows[i * 8 + 7]) as size_t))
            }
            w.key("request")
            w.begin_object()
            w.key("method")
            if tombstone
                w.text("DELETE")
            else
                w.text("PUT")
            w.key("url")
            w.text_dotnet(relative.as_slice())
            w.end_object()
            w.key("response")
            w.begin_object()
            w.key("status")
            if tombstone
                w.text("204")
            else
                w.text("200")
            w.key("lastModified")
            w.text_dotnet(found.as_slice().subslice(rows[i * 8 + 2] as size_t, (rows[i * 8 + 2] + rows[i * 8 + 3]) as size_t))
            w.end_object()
            w.end_object()
            i := i + 1
        }
        w.end_array()
    }
    w.end_object()
    send_resource(res, w.bytes())
}

; The search of a type by the pairs in text and cells, answered as a
; searchset Bundle the way upstream's handler builds it. `asked` is the
; query string as it came.
procedure search(req: ref[Request], mutable res: ref[Response], text: Slice[u8], cells: Slice[i64]) mutable pg_pool
{
    let type type_of(req)
    var count: i64 20
    var offset: i64 0
    if whole_number(first_value(text, cells, "_count"))
    {
        count := whole_value(first_value(text, cells, "_count"))
        if count < 0
            count := 0
        if count > 1000
            count := 1000
    }
    if whole_number(first_value(text, cells, "_offset"))
        offset := whole_value(first_value(text, cells, "_offset"))
    if first_value(text, cells, "_summary").equals("count")
        count := 0

    ; the chains, forward and reverse, become plain parameters
    var chained_text Array[u8]()
    var chained_cells Array[i64]()
    let chains resolve_chains(type, text, cells, &chained_text, &chained_cells)
    if chains = FAILED
        return send_unavailable(res)
    if chains <> STORED
        return send_error(res, "exception", "An unexpected internal error occurred.", 500)
    var plain_text Array[u8]()
    var plain_cells Array[i64]()
    let reverse resolve_reverse_chains(text, cells, chained_text.as_slice(), chained_cells.as_slice(), &plain_text, &plain_cells)
    if reverse = FAILED
        return send_unavailable(res)
    if reverse <> STORED
        return send_error(res, "exception", "An unexpected internal error occurred.", 500)

    var found Array[u8]()
    var rows Array[i64]()
    var problem Array[u8]()
    var result StoreResult(FAILED, 0, 0)
    if has_composites(text, cells)
    {
        ; the code parts are searched for, the answer is filtered here and
        ; the page taken from what is left
        var code_text Array[u8]()
        var code_cells Array[i64]()
        composite_pairs(text, cells, plain_text.as_slice(), plain_cells.as_slice(), &code_text, &code_cells)
        var all Array[u8]()
        var all_rows Array[i64]()
        result := resource_search(0, type, code_text.as_slice(), code_cells.as_slice(), 10000, 0, &all, &all_rows, &problem)
        var matching: i64 0
        var r: size_t 0
        while result.status = STORED and r * 4 < all_rows.length
        {
            let content all.as_slice().subslice(all_rows[r * 4 + 2] as size_t, (all_rows[r * 4 + 2] + all_rows[r * 4 + 3]) as size_t)
            if matches_composites(content, text, cells)
            {
                if matching >= offset and matching < offset + count
                {
                    cell(&found, &rows, all.as_slice().subslice(all_rows[r * 4] as size_t, (all_rows[r * 4] + all_rows[r * 4 + 1]) as size_t))
                    cell(&found, &rows, content)
                }
                matching := matching + 1
            }
            r := r + 1
        }
        if result.status = STORED
            result := StoreResult(STORED, matching, 0)
    }
    else
        result := resource_search(0, type, plain_text.as_slice(), plain_cells.as_slice(), count, offset, &found, &rows, &problem)
    if result.status = REFUSED
        return send_error(res, "invalid", problem.as_slice(), 400)
    if result.status = BROKEN
        return send_error(res, "exception", "An unexpected internal error occurred.", 500)
    if result.status <> STORED
        return send_unavailable(res)
    let total result.version_id
    var included Array[u8]()
    var included_cells Array[i64]()
    let includes resolve_includes(type, text, cells, found.as_slice(), rows.as_slice(), &included, &included_cells)
    if includes = FAILED
        return send_unavailable(res)
    if includes <> STORED
        return send_error(res, "exception", "An unexpected internal error occurred.", 500)

    ; http://host/fire/Type, and the page asked for
    var root Array[u8]()
    put_bytes(&root, "http://")
    root.add(trim(req.header("host")))
    put_bytes(&root, model_route())
    put_bytes(&root, "/")
    var base Array[u8]()
    base.add(root.as_slice())
    base.add(type)
    var w JsonWriter()
    w.begin_object()
    w.key("resourceType")
    w.text("Bundle")
    w.key("type")
    w.text("searchset")
    ; the links are made of the query string alone, also when the
    ; parameters came in a form; without a total there is no next page
    var asked_text Array[u8]()
    var asked_cells Array[i64]()
    parse_pairs(req.query, &asked_text, &asked_cells)
    var known total
    if first_value(text, cells, "_total").equals("none")
        known := -1
    w.key("link")
    page_links(&w, base.as_slice(), req.query, asked_text.as_slice(), asked_cells.as_slice(), known, count, offset)
    if first_value(text, cells, "_total").equals("none") = false
    {
        w.key("total")
        w.integer(total)
    }
    ; _summary and _elements cut every resource of the answer down
    let summary first_value(text, cells, "_summary")
    var has_elements false
    var e: size_t 0
    while e < pair_count(cells)
    {
        if pair_key(text, cells, e).equals("_elements")
            has_elements := true
        e := e + 1
    }
    let elements first_value(text, cells, "_elements")
    let cut subsetted(summary, has_elements)
    w.key("entry")
    w.begin_array()
    var i: size_t 0
    while i * 4 < rows.length
    {
        w.begin_object()
        w.key("fullUrl")
        var full Array[u8]()
        full.add(base.as_slice())
        put_bytes(&full, "/")
        full.add(found.as_slice().subslice(rows[i * 4] as size_t, (rows[i * 4] + rows[i * 4 + 1]) as size_t))
        w.text_dotnet(full.as_slice())
        w.key("resource")
        if cut
            write_subset(&w, found.as_slice().subslice(rows[i * 4 + 2] as size_t, (rows[i * 4 + 2] + rows[i * 4 + 3]) as size_t), summary, has_elements, elements)
        else
            w.raw(found.as_slice().subslice(rows[i * 4 + 2] as size_t, (rows[i * 4 + 2] + rows[i * 4 + 3]) as size_t))
        w.key("search")
        w.begin_object()
        w.key("mode")
        w.text("match")
        w.end_object()
        w.end_object()
        i := i + 1
    }
    i := 0
    while i * 4 < included_cells.length
    {
        w.begin_object()
        w.key("fullUrl")
        var full Array[u8]()
        full.add(root.as_slice())
        full.add(included.as_slice().subslice(included_cells[i * 4] as size_t, (included_cells[i * 4] + included_cells[i * 4 + 1]) as size_t))
        w.text_dotnet(full.as_slice())
        w.key("resource")
        if cut
            write_subset(&w, included.as_slice().subslice(included_cells[i * 4 + 2] as size_t, (included_cells[i * 4 + 2] + included_cells[i * 4 + 3]) as size_t), summary, has_elements, elements)
        else
            w.raw(included.as_slice().subslice(included_cells[i * 4 + 2] as size_t, (included_cells[i * 4 + 2] + included_cells[i * 4 + 3]) as size_t))
        w.key("search")
        w.begin_object()
        w.key("mode")
        w.text("include")
        w.end_object()
        w.end_object()
        i := i + 1
    }
    w.end_array()
    w.end_object()
    send_resource(res, w.bytes())
}

; GET /fire/<type>?...
procedure resource_search_get(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    var text Array[u8]()
    var cells Array[i64]()
    parse_pairs(req.query, &text, &cells)
    search(req, res, text.as_slice(), cells.as_slice())
}

; POST /fire/<type>/_search: the parameters of the form, then those of the
; query string.
procedure resource_search_post(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    var text Array[u8]()
    var cells Array[i64]()
    parse_pairs(req.body, &text, &cells)
    parse_pairs(req.query, &text, &cells)
    search(req, res, text.as_slice(), cells.as_slice())
}
