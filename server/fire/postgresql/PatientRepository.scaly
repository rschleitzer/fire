; Patient in PostgreSQL, on upstream's tables and in upstream's steps:
; every write is one transaction, the version that is replaced or deleted
; goes to the history first.

use pg.Conn.PgConn
use json.Value.JsonValue
use fire.Instant.Instant
use fire.Resource.PatientResult

; End the transaction on c and give c back: COMMIT when ok, else ROLLBACK.
procedure end_transaction(mutable c: ref[PgConn], ok: bool) returns bool mutable pg_pool
{
    var done false
    if ok
        done := c.execute("COMMIT")
    else
        c.execute("ROLLBACK")
    release(c)
    done
}

; The parameters every statement that writes a version ends with: version,
; last_updated, content, active, gender.
procedure version_params(mutable c: ref[PgConn], version_id: i64, now: Instant, content: Slice[u8], active: int, gender: Slice[u8])
{
    var timestamp Array[u8]()
    put_timestamp(&timestamp, now)
    c.param_int(version_id)
    c.param_text(timestamp.as_slice())
    c.param_bytes(content)
    if active < 0
        c.param_null()
    else
    {
        if active > 0
            c.param_text("t")
        else
            c.param_text("f")
    }
    if gender.length = 0
        c.param_null()
    else
        c.param_text(gender)
}

; The current version of `id`, the row locked: 0 when there is none, -1
; when the database did not answer.
procedure lock_current(mutable c: ref[PgConn], id: Slice[u8]) returns i64
{
    if c.prepare("patient_lock", "SELECT version_id FROM \"Patient\" WHERE id = $1 FOR UPDATE") = false
        return 0 - 1
    c.start("patient_lock")
    c.param_text(id)
    if c.run() = false
        return 0 - 1
    if c.next_row() = false
        return 0
    c.column_int(0)
}

; Copy the current version of `id` to the history.
procedure keep_history(mutable c: ref[PgConn], id: Slice[u8], operation: Slice[u8]) returns bool
{
    if c.prepare("patient_keep", "INSERT INTO \"Patient\".resource_history (id, version_id, last_updated, content, \"active\", \"gender\", history_operation) SELECT id, version_id, last_updated, content, \"active\", \"gender\", $2 FROM \"Patient\" WHERE id = $1") = false
        return false
    c.start("patient_keep")
    c.param_text(id)
    c.param_text(operation)
    c.run()
}

; Create the Patient `id` from root; its stored bytes are appended to
; content. An id the client chose (after_delete) continues the versions its
; history holds.
procedure patient_create(page: ref[Page], root: JsonValue, id: Slice[u8], after_delete: bool, mutable content: ref[Array[u8]]) returns PatientResult mutable pg_pool
{
    let got acquire()
    if got = null
        return PatientResult(FAILED, 0, 0)
    var c got as ref[PgConn]
    var version_id: i64 1
    var ok c.execute("BEGIN")
    if ok and after_delete
    {
        ok := c.prepare("patient_versions", "SELECT COALESCE(MAX(version_id), 0) FROM \"Patient\".resource_history WHERE id = $1")
        if ok
        {
            c.start("patient_versions")
            c.param_text(id)
            ok := c.run() and c.next_row()
            if ok and c.column_int(0) > 0
                version_id := c.column_int(0) + 1
        }
    }
    let now instant_now()
    if ok
    {
        write_resource(page, root, id, version_id, now, content)
        ok := c.prepare("patient_insert", "INSERT INTO \"Patient\" (id, version_id, last_updated, content, \"active\", \"gender\") VALUES ($1, $2, $3, $4, $5, $6)")
    }
    if ok
    {
        c.start("patient_insert")
        c.param_text(id)
        version_params(c, version_id, now, content.as_slice(), inline_boolean(root, "active"), root.get("gender").text())
        ok := c.run()
    }
    if end_transaction(c, ok) = false
        return PatientResult(FAILED, 0, 0)
    PatientResult(STORED, version_id, now.seconds)
}

; Replace the Patient `id` by root; if_match is the version the client
; expects, 0 for none.
procedure patient_update(page: ref[Page], root: JsonValue, id: Slice[u8], if_match: i64, mutable content: ref[Array[u8]]) returns PatientResult mutable pg_pool
{
    let got acquire()
    if got = null
        return PatientResult(FAILED, 0, 0)
    var c got as ref[PgConn]
    if c.execute("BEGIN") = false
    {
        end_transaction(c, false)
        return PatientResult(FAILED, 0, 0)
    }
    let current lock_current(c, id)
    if current <= 0 or (if_match > 0 and if_match <> current)
    {
        end_transaction(c, false)
        if current < 0
            return PatientResult(FAILED, 0, 0)
        if current = 0
            return PatientResult(NOT_FOUND, 0, 0)
        return PatientResult(CONFLICT, current, 0)
    }
    var ok keep_history(c, id, "UPDATE")
    let now instant_now()
    if ok
    {
        write_resource(page, root, id, current + 1, now, content)
        ok := c.prepare("patient_update", "UPDATE \"Patient\" SET version_id = $2, last_updated = $3, content = $4, \"active\" = $5, \"gender\" = $6 WHERE id = $1")
    }
    if ok
    {
        c.start("patient_update")
        c.param_text(id)
        version_params(c, current + 1, now, content.as_slice(), inline_boolean(root, "active"), root.get("gender").text())
        ok := c.run()
    }
    if end_transaction(c, ok) = false
        return PatientResult(FAILED, 0, 0)
    PatientResult(STORED, current + 1, now.seconds)
}

; Delete the Patient `id`: STORED, NOT_FOUND or FAILED.
procedure patient_delete(id: Slice[u8]) returns int mutable pg_pool
{
    let got acquire()
    if got = null
        return FAILED
    var c got as ref[PgConn]
    if c.execute("BEGIN") = false
    {
        end_transaction(c, false)
        return FAILED
    }
    let current lock_current(c, id)
    if current <= 0
    {
        end_transaction(c, false)
        if current < 0
            return FAILED
        return NOT_FOUND
    }
    var ok keep_history(c, id, "DELETE")
    if ok
        ok := c.prepare("patient_delete", "DELETE FROM \"Patient\" WHERE id = $1")
    if ok
    {
        c.start("patient_delete")
        c.param_text(id)
        ok := c.run()
    }
    if end_transaction(c, ok) = false
        return FAILED
    STORED
}

; Was the Patient `id` deleted at some time?
procedure patient_is_deleted(id: Slice[u8]) returns bool mutable pg_pool
{
    let got acquire()
    if got = null
        return false
    var c got as ref[PgConn]
    var deleted false
    if c.prepare("patient_deleted", "SELECT COUNT(*) FROM \"Patient\".resource_history WHERE id = $1 AND history_operation = 'DELETE'")
    {
        c.start("patient_deleted")
        c.param_text(id)
        deleted := c.run() and c.next_row() and c.column_int(0) > 0
    }
    release(c)
    deleted
}

; One row of statement `name` (id, and version_id when it is not 0, as
; parameters; version_id, the second, content as columns) into content.
procedure select_row(mutable c: ref[PgConn], name: Slice[u8], id: Slice[u8], version_id: i64, mutable content: ref[Array[u8]]) returns PatientResult
{
    c.start(name)
    c.param_text(id)
    if version_id > 0
        c.param_int(version_id)
    c.binary_column(2)
    if c.run() = false
        return PatientResult(FAILED, 0, 0)
    if c.next_row() = false
        return PatientResult(NOT_FOUND, 0, 0)
    content.add(c.column(2))
    PatientResult(STORED, c.column_int(0), c.column_int(1))
}

; Read the Patient `id` -- its current version, or version_id (not 0) from
; the current row or the history; the content is appended to `content`.
procedure patient_select(id: Slice[u8], version_id: i64, mutable content: ref[Array[u8]]) returns PatientResult mutable pg_pool
{
    let got acquire()
    if got = null
        return PatientResult(FAILED, 0, 0)
    var c got as ref[PgConn]
    var result PatientResult(FAILED, 0, 0)
    if version_id = 0
    {
        if c.prepare("patient_select", "SELECT version_id, FLOOR(EXTRACT(EPOCH FROM last_updated))::BIGINT, content FROM \"Patient\" WHERE id = $1")
            result := select_row(c, "patient_select", id, 0, content)
    }
    else
    {
        if c.prepare("patient_version", "SELECT version_id, FLOOR(EXTRACT(EPOCH FROM last_updated))::BIGINT, content FROM \"Patient\" WHERE id = $1 AND version_id = $2")
            result := select_row(c, "patient_version", id, version_id, content)
        if result.status = NOT_FOUND and c.prepare("patient_history", "SELECT version_id, FLOOR(EXTRACT(EPOCH FROM last_updated))::BIGINT, content FROM \"Patient\".resource_history WHERE id = $1 AND version_id = $2")
            result := select_row(c, "patient_history", id, version_id, content)
    }
    release(c)
    result
}
